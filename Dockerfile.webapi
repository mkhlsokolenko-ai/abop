# ABOP Web API (REST/SSE поверх ядра ape) — для деплоя на сервер с persist в Postgres.
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# Зависимости списком: pyproject с 08.10 держит только настройку линтера — манифест курсового
# пакета убран оттуда вместе с самим курсовым слоем.
# fastmcp нужен, только когда включён MCP-сервер (ABOP_MCP=1). Кладём в образ, чтобы включение
# было переменной окружения, а не пересборкой.
RUN pip install --upgrade pip && pip install \
    "httpx>=0.27" "psycopg[binary,pool]>=3.2" "python-dotenv>=1.0" \
    "pydantic>=2.7" "fastapi>=0.115" "uvicorn[standard]>=0.30" "pyjwt[crypto]>=2.9" \
    "minio>=7.2" "python-multipart>=0.0.9" "fastmcp>=4.0" \
    openpyxl pypdf jsonschema psycopg2-binary aiokafka

COPY server ./server
COPY cli ./cli
COPY skills ./skills
COPY reports ./reports
COPY webapp ./webapp
COPY demo ./demo
# Пакеты вертикалей — поставка: без них нет ни правил, ни рецептов, ни норм в образе.
COPY verticals ./verticals
COPY desktop/ui ./desktop/ui
# Ops-скрипты (перенос карты, чистка мёртвых настроек, проверка шаблонов): руководство
# администратора зовёт их как `docker exec abop-webapi python scripts/...` — без этой строки
# документ обещал то, чего в образе нет.
COPY scripts ./scripts
# ops-инструменты засева демо-стендов: руководства и демо-гиды зовут их по имени
COPY ops ./ops
# руководства поставки — отдаются по /guide и открываются из «Помощи»
COPY docs/guide ./docs/guide

EXPOSE 8091
CMD ["uvicorn", "server.web_api:app", "--host", "0.0.0.0", "--port", "8091"]
