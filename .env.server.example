# Пример .env для деплоя ABOP Web API на сервер (скопировать в .env, заполнить секреты).
# Запуск: docker build -f Dockerfile.webapi -t abop-webapi . && docker run -d --name abop-webapi \
#   --restart unless-stopped --network host --env-file .env -v abop_ape:/root/.ape abop-webapi
ROUTEAI_BASE_URL=https://routerai.ru/api/v1
ROUTEAI_API_KEY=CHANGE_ME
ROUTEAI_CODE_CASCADE=qwen/qwen3.8-27b,deepseek/deepseek-v4-pro
ROUTEAI_RESEARCH_CASCADE=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash
ROUTEAI_STANDARD_CASCADE=qwen/qwen3-30b-a3b-instruct-2507,deepseek/deepseek-v4-flash
# Postgres persist (agent/contract/run). Пустой = in-memory (dev).
POSTGRES_DSN=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/abop
# Keycloak (пусто = dev-режим без токена)
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URI=
KEYCLOAK_AUDIENCE=
# LLM-прогон: CONCURRENCY — батч к RouteAI; TRUNCATE=0 на проде (полные промпты), 1 в dev (обрезка)
ABOP_RUN_LLM_CONCURRENCY=2
ABOP_RUN_LLM_TRUNCATE=0
LOG_LEVEL=INFO
