# Secrets — never commit
.env
*.env
!.env.example
bench/.orkey
bench/report_*.json
bench/verify_*.json
data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
# Исключение из правила выше: desktop/build — это РЕСУРСЫ сборки (иконки, хук electron-builder),
# а не её продукт (продукт в desktop/dist). Каталог обязан быть виден гиту: из исключённого
# каталога отдельный файл обратно не вернёшь, и новый build/afterPack.js молча не доехал до CI.
# Что внутри пускать, решает desktop/.gitignore.
!desktop/build/
# Артефакты сборки PyInstaller-сайдкара (desktop)
desktop/build-sidecar/
desktop/dist/

# Editors / OS
.vscode/
.idea/
.DS_Store
desktop.ini
Thumbs.db

# Data / logs
*.log
data/
outputs/

# Временные рабочие файлы (Python-патчеры бандла, дампы, деплой-архивы)
_*
