# ─────────────────────────────────────────────────────────────
# AI Product Engineer — курсовой FastMCP-сервер
# Скопируй в .env и заполни. .env в git НЕ коммитится.
# Значения ниже — под server-1 (sLAVA-пилот, 201.51.5.24),
# MCP запускается НА этом же сервере и ходит в сервисы по 127.0.0.1.
# ─────────────────────────────────────────────────────────────

# --- Транспорт MCP ---
MCP_HOST=127.0.0.1
MCP_PORT=8787
# Публично наружу отдаёт Caddy (TLS) — см. docker-compose / DEPLOY.md
PUBLIC_BASE_URL=https://mcp.engineer-ai.pro

# --- Keycloak (OIDC / JWT) ---
# realm студентов курса. FastMCP валидирует JWT по JWKS этого realm.
KEYCLOAK_ISSUER=https://auth.engineer-ai.pro/realms/ai-product-engineer
KEYCLOAK_JWKS_URI=https://auth.engineer-ai.pro/realms/ai-product-engineer/protocol/openid-connect/certs
# audience, который курс прошивает в токены (client_id или кастомный aud)
KEYCLOAK_AUDIENCE=course-mcp

# --- RouteAI (LLM + embeddings, OpenAI-совместимый gateway) ---
# Тот же ключ/endpoint, что уже настроен у sLAVA (routerai.ru).
ROUTEAI_BASE_URL=https://routerai.ru/api/v1
ROUTEAI_API_KEY=CHANGE_ME
# Каскады моделей по профилю задачи (первая живая — отвечает). Всё на RouteAI.
# Политика маршрутизации:
#   profile=code     -> ROUTEAI_CODE_CASCADE      (Qwen3.8-27B на RouteAI, fallback DeepSeek)
#   profile=research -> ROUTEAI_RESEARCH_CASCADE  (только DeepSeek)
#   profile=standard -> ROUTEAI_STANDARD_CASCADE  (агентский движок: qwen3-30b-a3b-instruct-2507)
# /code и агенты идут на RouteAI, не на self-host. Чтобы вернуть код на свою RTX 6000 —
# поставь ROUTEAI_CODE_CASCADE=local/qwen3.8-27b,... и подними vLLM (см. LOCAL_LLM ниже).
ROUTEAI_CODE_CASCADE=qwen/qwen3.8-27b,deepseek/deepseek-v4-pro
ROUTEAI_RESEARCH_CASCADE=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash
ROUTEAI_STANDARD_CASCADE=qwen/qwen3-30b-a3b-instruct-2507,deepseek/deepseek-v4-flash
ROUTEAI_EMBED_MODEL=bge-m3

# --- Локальный self-hosted LLM (vLLM, OpenAI-совместимый) — ОПЦИЯ, по умолчанию выкл ---
# Любая модель "local/..." из каскада роутится сюда вместо RouteAI.
# Наш сетап: арендованная RTX 6000 (48GB) @ $0.60/ч, Qwen3.8-27B AWQ-int4.
# Запуск vLLM (пример):
#   vllm serve Qwen/Qwen3.8-27B-AWQ --quantization awq --port 8001 \
#     --max-model-len 131072 --gpu-memory-utilization 0.92
# 48GB: int4 весов ~14GB, остаток под KV. НЕ ставь max-model-len=1M — KV-кэш
# съест память и убьёт concurrency; 32k–128k для кодинга достаточно.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=Qwen/Qwen3.8-27B-AWQ
LOCAL_LLM_API_KEY=EMPTY

# --- Qdrant (переиспользуем инстанс sLAVA) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Префикс коллекций курса, чтобы не пересекаться с корпусом sLAVA.
QDRANT_COLLECTION_PREFIX=ape_

# --- Reranker ---
# routerai  -> BGE-reranker через RouteAI (по умолчанию)
# slava      -> дёргаем /rerank живого sLAVA-API на 127.0.0.1:8000
RERANKER_BACKEND=routerai
RERANKER_MODEL=bge-reranker-v2-m3
SLAVA_API_BASE_URL=http://127.0.0.1:8000

# --- Postgres (cost_journal + per-student квоты) ---
# Внутри compose MCP ходит к postgres по имени сервиса. PG_PASSWORD общий для
# cost_journal и БД keycloak (см. docker-compose + db/init-keycloak.sql).
PG_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DSN=postgresql://ape:CHANGE_ME_STRONG@postgres:5432/ape

# --- Keycloak (bootstrap-админ realm-management) ---
# Первичный админ мастер-realm. После первого входа смени пароль.
KC_ADMIN=admin
KC_ADMIN_PASSWORD=CHANGE_ME_STRONG
# GitHub Identity Provider (создай OAuth App, см. keycloak/README.md).
# Callback: https://auth.engineer-ai.pro/realms/ai-product-engineer/broker/github/endpoint
KC_GITHUB_CLIENT_ID=
KC_GITHUB_CLIENT_SECRET=

# --- Квоты ---
# ЕДИНСТВЕННЫЙ действующий лимит — недельный потолок токенов на студента.
# Лимиты на сессию и на число сессий сняты (session_id — техническая группировка
# вызовов, переподключения CLI не должны упираться в лимит). Значения ниже двух
# первых оставлены для справочной метрики в отчёте, но НЕ ограничивают.
WEEKLY_TOKEN_LIMIT=25000000
PER_SESSION_TOKEN_LIMIT=25000000
SESSIONS_PER_WEEK=0

# --- Курс ---
COURSE_EMBED_DIM=1024
# Дата старта (для расчёта текущей недели/дедлайнов на дашборде) и длительность.
COURSE_START_DATE=2026-09-01
COURSE_WEEKS=15
# Langfuse (наблюдаемость агентов) — публичный URL, если отдаём студентам. Пусто = скрыто.
LANGFUSE_URL=
LOG_LEVEL=INFO
