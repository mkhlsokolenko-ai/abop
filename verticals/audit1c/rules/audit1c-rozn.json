   "из": "doc1c",
   "по": {
    "Основание_uuid": "$запись.id",
    "тип": "ПоступлениеНаРасчётныйСчёт"
   },
   "необязательно": true
  },
  {
   "имя": "оплата_поставщику",
   "из": "doc1c",
   "по": {
    "Основание_uuid": "$запись.id",
    "тип": "СписаниеСРасчётногоСчёта"
   },
   "необязательно": true
  },
  {
   "имя": "сф_выданный",
