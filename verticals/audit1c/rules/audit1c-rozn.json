    },
    {
      "имя": "оплата_поставщику",
      "из": "doc1c",
      "по": {
        "Основание_uuid": "$запись.id",
        "тип": "СписаниеСРасчётногоСчёта"
      },
      "необязательно": true
    },
    {
      "имя": "сф_выданный",
      "из": "doc1c",
      "по": {
        "Основание_uuid": "$запись.id",
        "тип": "СчётФактураВыданный"
      },
      "необязательно": true
    },
    {
      "имя": "сф_полученный",
