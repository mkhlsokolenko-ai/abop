   "по": {
    "Основание_uuid": "$запись.id",
    "тип": "СчётФактураВыданный"
   },
   "необязательно": true
  },
  {
   "имя": "сф_полученный",
   "из": "doc1c",
   "по": {
    "Основание_uuid": "$запись.id",
    "тип": "СчётФактураПолученный"
   },
   "необязательно": true
  },
  {
   "имя": "основание",
