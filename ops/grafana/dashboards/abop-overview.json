{
  "annotations": {
    "list": []
  },
  "editable": true,
  "title": "ABOP — Обзор (прогоны, латентность, стоимость, LLM)",
  "uid": "abop-overview",
  "tags": [
    "abop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Прогонов (всего)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(abop_runs_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "abop-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "abop-prom"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Успешных %",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(abop_runs_total{ok=\"true\"}) / clamp_min(sum(abop_runs_total), 1)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "abop-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "abop-prom"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Стоимость LLM (₽, всего)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(abop_run_cost_rub_total)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "abop-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "abop-prom"
      }
    },
