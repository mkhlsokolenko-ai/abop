 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Прогонов (всего)",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(abop_runs_total)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     }
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Успешных %",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "targets": [
    {
     "expr": "100 * sum(abop_runs_total{ok=\"true\"}) / clamp_min(sum(abop_runs_total), 1)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 70
       },
       {
        "color": "green",
        "value": 90
       }
      ]
     }
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Стоимость LLM (₽, всего)",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(abop_run_cost_rub_total)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
