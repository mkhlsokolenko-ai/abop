{
  "name": "Архитектура памяти агента (memory-architect)",
  "instruction": "По описанию агента, его сценариев и требований из блока данных спроектируй двухуровневую память: short-term (управление окном контекста), long-term (хранилище, структура записи, retrieval перед ответом), дистилляция отдельным дешёвым LLM-вызовом (один факт — одна запись, без дублей, запись в cost-журнал), критерий «что помнить», retention/TTL и забывание по критичности, минимизация и маскирование ПДн. Хранилища, объёмы, категории данных и лимиты бери только из данных; чего нет — «не удалось определить», предположения помечай в допущениях.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "агент",
      "short_term",
      "long_term",
      "критерий_что_помнить",
      "дистилляция",
      "retrieval",
      "retention",
      "пдн_и_чувствительное",
      "оценка_токенов",
      "допущения",
      "открытые_вопросы",
      "итог"
    ],
    "properties": {
      "агент": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "название",
          "сценарий",
          "длина_сессий",
          "источник"
        ],
        "properties": {
          "название": {
            "type": "string"
          },
          "сценарий": {
            "type": "string",
            "description": "для чего нужна память между сессиями"
          },
          "длина_сессий": {
            "type": "string",
            "description": "типичная длина разговора и частота сессий по данным"
          },
          "источник": {
            "type": "string",
            "description": "описание агента, дизайн-док, обсуждение"
          }
        }
      },
      "short_term": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "стратегия",
          "порог_срабатывания",
          "что_вырезаем",
          "что_сохраняем_всегда"
        ],
        "properties": {
          "стратегия": {
            "type": "string",
            "enum": [
              "compaction",
              "context-editing",
              "скользящее окно",
              "суммаризация",
              "комбинация"
            ]
          },
          "порог_срабатывания": {
            "type": "string",
            "description": "при каком заполнении окна или числе ходов срабатывает"
          },
          "что_вырезаем": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "что можно убрать из контекста первым"
          },
          "что_сохраняем_всегда": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "что остаётся в окне до конца сессии"
          }
        }
      },
      "long_term": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "хранилище",
          "обоснование",
          "структура_записи",
          "ключи_поиска"
        ],
        "properties": {
          "хранилище": {
            "type": "string",
            "enum": [
              "Postgres",
              "Qdrant",
              "pgvector",
              "иное",
              "не удалось определить"
            ]
          },
          "обоснование": {
            "type": "string"
          },
          "структура_записи": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "поля записи: факт, summary, источник, критичность, ttl, created_at и т.п."
          },
          "ключи_поиска": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "по чему ищем: пользователь, тема, эмбеддинг summary"
          }
        }
      },
      "критерий_что_помнить": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "правило",
          "помним",
          "не_помним"
        ],
        "properties": {
          "правило": {
            "type": "string",
            "description": "одна формулировка: помним только то, что меняет будущие ответы"
          },
          "помним": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "примеры фактов, которые стоит хранить"
          },
          "не_помним": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "что не пишем: сырая история, повторы, чувствительное без нужды"
          }
        }
      },
      "дистилляция": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "триггер",
          "профиль_модели",
          "промпт_кратко",
          "дедупликация",
          "запись_в_cost_журнал"
        ],
        "properties": {
          "триггер": {
            "type": "string",
            "description": "когда запускается: конец сессии, каждые N ходов, по событию"
          },
          "профиль_модели": {
            "type": "string",
            "description": "дешёвый профиль, например research/DeepSeek"
          },
          "промпт_кратко": {
            "type": "string",
            "description": "суть инструкции «извлеки факты из этого куска»"
          },
          "дедупликация": {
            "type": "string",
            "description": "как избегаем дублей и обновляем устаревшее"
          },
          "запись_в_cost_журнал": {
            "type": "boolean",
            "description": "true — каждый вызов дистилляции логируется"
          }
        }
      },
      "retrieval": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "когда",
          "как",
          "top_k",
          "как_подмешивается"
        ],
        "properties": {
          "когда": {
            "type": "string",
            "description": "перед каким шагом ответа"
          },
          "как": {
            "type": "string",
            "description": "фильтр по ключам, векторный поиск, гибрид"
          },
          "top_k": {
            "type": "string",
            "description": "сколько записей подмешиваем"
          },
          "как_подмешивается": {
            "type": "string",
            "description": "куда попадает в промпт и в каком формате"
          }
        }
      },
      "retention": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "класс_записи",
            "критичность",
            "ttl",
            "правило_забывания"
          ],
          "properties": {
            "класс_записи": {
              "type": "string",
              "description": "тип факта: предпочтения, договорённости, идентификаторы, ПДн"
            },
            "критичность": {
              "type": "string",
              "enum": [
                "высокая",
                "средняя",
                "низкая"
              ]
            },
            "ttl": {
              "type": "string",
              "description": "срок жизни строкой: «30 дней», «до конца проекта», «бессрочно»"
            },
            "правило_забывания": {
              "type": "string",
              "description": "когда удаляем или обновляем"
            }
          }
        }
      },
      "пдн_и_чувствительное": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "категории",
          "маскирование",
          "право_на_забвение"
        ],
        "properties": {
          "категории": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "какие ПДн и чувствительные данные могут попасть в память по данным"
          },
          "маскирование": {
            "type": "string",
            "description": "что и как маскируем перед записью"
          },
          "право_на_забвение": {
            "type": "string",
            "description": "как удаляем по запросу пользователя"
          }
        }
      },
      "оценка_токенов": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "на_вызов_с_памятью",
          "на_дистилляцию",
          "экономия_vs_вся_история"
        ],
        "properties": {
          "на_вызов_с_памятью": {
            "type": "string",
            "description": "сколько токенов добавляет retrieval; строкой или «не удалось определить»"
          },
          "на_дистилляцию": {
            "type": "string",
            "description": "стоимость одного вызова дистилляции"
          },
          "экономия_vs_вся_история": {
            "type": "string",
            "description": "сравнение с передачей всей истории"
          }
        }
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "открытые_вопросы": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что уточнить у владельца агента"
      },
      "итог": {
        "type": "string",
        "description": "2–3 предложения: как устроена память и что она даёт"
      }
    }
  },
  "max_tokens": 4000,
  "inputs": {
    "required": [
      {
        "from": "context",
        "note": "что агент должен помнить и зачем"
      }
    ],
    "optional": [
      {
        "from": "data",
        "entity": "document",
        "fields": [
          "id",
          "title"
        ]
      }
    ]
  },
  "produces": [
    {
      "path": "retention",
      "key": "слой",
      "join": "слой_памяти"
    }
  ]
}
