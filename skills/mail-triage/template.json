{
  "name": "Дайджест задач · разбор почты (mail-triage)",
  "instruction": "Разбери письма из данных (сущность email: тема, отправитель, дата, тело) на задачи. Задача = конкретное действие с исполнителем-адресатом, отправителем, сроком и срочностью. FYI, рассылки и спам — в отдельный список, не в задачи. Ничего не выдумывай сверх писем; если срока нет — так и пиши. id письма и отправитель — из данных.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["писем_разобрано", "задачи", "без_действия", "требуют_уточнения", "итог"],
    "properties": {
      "писем_разобрано": {"type": "integer"},
      "задачи": {
        "type": "array",
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["задача", "действие", "письмо", "отправитель", "дата_письма", "срок", "срочность", "важность", "кому_ответить", "основание"],
          "properties": {
            "задача": {"type": "string", "description": "короткое название, глагол в инфинитиве: «Подготовить…», «Согласовать…»"},
            "действие": {"type": "string", "description": "что конкретно сделать, 1–2 предложения"},
            "письмо": {"type": "string", "description": "id письма из данных"},
            "отправитель": {"type": "string", "description": "адрес/имя из письма"},
            "дата_письма": {"type": "string", "description": "ГГГГ-ММ-ДД"},
            "срок": {"type": "string", "description": "ГГГГ-ММ-ДД или «не указан»"},
            "срочность": {"type": "string", "enum": ["сегодня", "на этой неделе", "без срока"]},
            "важность": {"type": "string", "enum": ["высокая", "средняя", "низкая"], "description": "по роли отправителя и последствиям"},
            "кому_ответить": {"type": "string"},
            "основание": {"type": "string", "description": "цитата или пересказ фразы письма, из которой следует задача"}
          }
        }
      },
      "без_действия": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["письмо", "тип", "почему"], "properties": {"письмо": {"type": "string"}, "тип": {"type": "string", "enum": ["FYI", "рассылка", "спам", "уже сделано"]}, "почему": {"type": "string"}}}},
      "требуют_уточнения": {"type": "array", "items": {"type": "string"}, "description": "письма, где непонятно, есть ли действие — вопрос отправителю"},
      "итог": {"type": "string", "description": "сколько задач, сколько срочных, что первым"}
    }
  }
}
