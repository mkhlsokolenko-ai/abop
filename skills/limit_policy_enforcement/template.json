{
  "name": "Применение лимитно-скоринговой политики (limit_policy_enforcement)",
  "instruction": "По данным клиента (customer: риск-балл/скоринг, доход, долговая нагрузка PTI/DTI, кредитная история) и поведенческим данным (transaction) примени кредитную политику к валидной заявке по порядку: стоп-факторы (hard-decline) → предельный лимит по доходу/PTI и продуктовым потолкам → ставка и срок по риск-сегменту. Итоговый лимит = минимум из запрошенного, лимита по доходу, продуктового потолка и лимита риск-сегмента; явно назови связывающее ограничение. Каждый шаг трассируй: пункт политики, вход, результат; вердикт approved / counter_offer / declined с причиной, понятной клиенту. Суммы, ставки, баллы и id — только из данных и правил политики, не назначай лимит «из головы»; чего нет в данных — «не удалось определить», допущения помечай явно. Фактическое одобрение — под HITL: укажи, требуется ли оно.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "заявка",
      "входные_данные",
      "стоп_факторы",
      "ограничения_лимита",
      "решение_по_лимиту",
      "вердикт",
      "причина_для_клиента",
      "трассировка",
      "hitl",
      "допущения",
      "итог"
    ],
    "properties": {
      "заявка": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "клиент_id",
          "продукт",
          "запрошенная_сумма",
          "запрошенный_срок"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "id заявки"
          },
          "клиент_id": {
            "type": "string"
          },
          "продукт": {
            "type": "string"
          },
          "запрошенная_сумма": {
            "type": "string",
            "description": "с валютой, напр. «500 000,00 ₽»"
          },
          "запрошенный_срок": {
            "type": "string",
            "description": "напр. «36 мес.»"
          }
        }
      },
      "входные_данные": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "риск_балл",
          "риск_сегмент",
          "доход",
          "долговая_нагрузка",
          "кредитная_история",
          "источники"
        ],
        "properties": {
          "риск_балл": {
            "type": "string",
            "description": "результат скоринга из данных или «не удалось определить»"
          },
          "риск_сегмент": {
            "type": "string",
            "description": "сегмент по политике"
          },
          "доход": {
            "type": "string",
            "description": "подтверждённый доход в месяц, с валютой"
          },
          "долговая_нагрузка": {
            "type": "string",
            "description": "PTI/DTI в %, включая новую заявку, если посчитано политикой"
          },
          "кредитная_история": {
            "type": "string",
            "description": "кратко: просрочки, активные кредиты, из КИ"
          },
          "источники": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "сущность/поле/id записи для каждого входа"
          }
        },
        "description": "вход политики; ничего не оценивать «на глаз»"
      },
      "стоп_факторы": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "правило",
            "пункт_политики",
            "вход",
            "сработал",
            "комментарий"
          ],
          "properties": {
            "правило": {
              "type": "string"
            },
            "пункт_политики": {
              "type": "string"
            },
            "вход": {
              "type": "string",
              "description": "значение из данных, к которому применено правило"
            },
            "сработал": {
              "type": "boolean"
            },
            "комментарий": {
              "type": "string"
            }
          }
        },
        "description": "hard-decline проверки, все — включая не сработавшие"
      },
      "ограничения_лимита": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ограничение",
            "сумма",
            "пункт_политики",
            "вход",
            "связывающее"
          ],
          "properties": {
            "ограничение": {
              "type": "string",
              "enum": [
                "запрошено",
                "по_доходу_pti",
                "продуктовый_потолок",
                "риск_сегмент",
                "иное"
              ]
            },
            "сумма": {
              "type": "string",
              "description": "предельная сумма по этому ограничению, с валютой"
            },
            "пункт_политики": {
              "type": "string"
            },
            "вход": {
              "type": "string",
              "description": "что подставлено в правило (доход, PTI, сегмент)"
            },
            "связывающее": {
              "type": "boolean",
              "description": "true у ограничения с минимальной суммой"
            }
          }
        },
        "description": "все ограничения, из которых берётся минимум"
      },
      "решение_по_лимиту": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "итоговый_лимит",
          "связывающее_ограничение",
          "ставка",
          "срок",
          "пункт_политики_условий"
        ],
        "properties": {
          "итоговый_лимит": {
            "type": "string",
            "description": "min по ограничениям, с валютой; «—» при declined"
          },
          "связывающее_ограничение": {
            "type": "string",
            "description": "какое ограничение задало итоговый лимит и почему"
          },
          "ставка": {
            "type": "string",
            "description": "% годовых по риск-сегменту или «не удалось определить»"
          },
          "срок": {
            "type": "string"
          },
          "пункт_политики_условий": {
            "type": "string",
            "description": "пункт, задающий ставку/срок для риск-сегмента"
          }
        },
        "description": "лимит и условия, выведенные из правил, не «из головы»"
      },
      "вердикт": {
        "type": "string",
        "enum": [
          "approved",
          "counter_offer",
          "declined"
        ],
        "description": "counter_offer — запрошено больше доступного лимита"
      },
      "причина_для_клиента": {
        "type": "string",
        "description": "формулировка отказа/встречного предложения без внутренних терминов"
      },
      "трассировка": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "шаг",
            "пункт_политики",
            "вход",
            "результат"
          ],
          "properties": {
            "шаг": {
              "type": "string",
              "description": "порядковый шаг применения политики"
            },
            "пункт_политики": {
              "type": "string"
            },
            "вход": {
              "type": "string"
            },
            "результат": {
              "type": "string"
            }
          }
        },
        "description": "цепочка вход → правило → результат, воспроизводимая регулятором"
      },
      "hitl": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "требуется",
          "причина"
        ],
        "properties": {
          "требуется": {
            "type": "boolean",
            "description": "true, если сумма пограничная/крупная или политика требует ручного одобрения"
          },
          "причина": {
            "type": "string",
            "description": "почему нужен человек; пусто, если не требуется"
          }
        },
        "description": "границы автономии: одобрение/выдача — по DeploymentContract"
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "итог": {
        "type": "string",
        "description": "2–4 предложения: вердикт, лимит, связывающее ограничение, следующий шаг"
      }
    }
  },
  "max_tokens": 4000,
  "inputs": {
    "required": [
      {
        "from": "data",
        "entity": "customer",
        "fields": [
          "id"
        ]
      },
      {
        "from": "data",
        "entity": "transaction",
        "fields": [
          "id",
          "amount"
        ]
      }
    ],
    "optional": [
      {
        "from": "skill",
        "skill": "application_intake_validation",
        "path": "стоп_факторы",
        "fields": [
          "фактор",
          "основание"
        ]
      }
    ]
  },
  "produces": [
    {
      "path": "ограничения_лимита",
      "key": "ограничение",
      "join": "ограничение"
    },
    {
      "path": "стоп_факторы",
      "key": "правило",
      "join": "стоп_фактор"
    }
  ]
}
