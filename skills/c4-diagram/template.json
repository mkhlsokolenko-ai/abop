{
  "name": "Диаграмма C4 как код (c4-diagram)",
  "instruction": "По описанию системы, топологии из репозитория/конфигов и обсуждению в блоке данных построй одну диаграмму ровно одного уровня C4 (Context, Container, Component) или потока (Sequence) или данных (ER): перечисли элементы с ролями, связи с подписью «действие + протокол», легенду и выдай полный исходник диаграммы в синтаксисе движка (Mermaid по умолчанию). Имена сервисов, БД, очередей, протоколов — только из данных; элемент, которого нет в данных, не добавляй; чего не хватает — «не удалось определить», предположения помечай в допущениях. Не вставляй секреты, реальные хосты и ключи — только роли и протоколы.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "диаграмма",
      "элементы",
      "связи",
      "легенда",
      "код_диаграммы",
      "проверка_синтаксиса",
      "что_не_показано",
      "допущения",
      "открытые_вопросы",
      "итог"
    ],
    "properties": {
      "диаграмма": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "вопрос",
          "уровень",
          "аудитория",
          "движок",
          "тип_диаграммы",
          "название"
        ],
        "properties": {
          "вопрос": {
            "type": "string",
            "description": "на какой один вопрос отвечает диаграмма"
          },
          "уровень": {
            "type": "string",
            "enum": [
              "System Context",
              "Container",
              "Component",
              "Sequence",
              "ER"
            ],
            "description": "Code не рисуем руками"
          },
          "аудитория": {
            "type": "string",
            "enum": [
              "бизнес и заказчик",
              "тех-команда",
              "разработчик контейнера"
            ]
          },
          "движок": {
            "type": "string",
            "enum": [
              "Mermaid",
              "PlantUML",
              "C4-PlantUML"
            ]
          },
          "тип_диаграммы": {
            "type": "string",
            "description": "flowchart TB / sequenceDiagram / erDiagram / C4_Container и т.п."
          },
          "название": {
            "type": "string",
            "description": "заголовок диаграммы"
          }
        }
      },
      "элементы": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "название",
            "тип",
            "роль",
            "технология",
            "источник"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "идентификатор узла в коде диаграммы, латиницей"
            },
            "название": {
              "type": "string",
              "description": "существительное с ролью: «API sLAVA», «Qdrant (вектор-БД)»"
            },
            "тип": {
              "type": "string",
              "enum": [
                "персона",
                "система",
                "внешняя система",
                "контейнер",
                "компонент",
                "хранилище",
                "очередь",
                "сущность данных"
              ]
            },
            "роль": {
              "type": "string",
              "description": "что делает элемент, 1 фраза"
            },
            "технология": {
              "type": "string",
              "description": "язык/продукт/протокол или пустая строка"
            },
            "источник": {
              "type": "string",
              "description": "откуда известно: файл, конфиг, обсуждение; или «предположение»"
            }
          }
        }
      },
      "связи": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "от",
            "к",
            "действие",
            "протокол",
            "критичность"
          ],
          "properties": {
            "от": {
              "type": "string",
              "description": "id инициатора вызова"
            },
            "к": {
              "type": "string",
              "description": "id получателя"
            },
            "действие": {
              "type": "string",
              "description": "что делает: «читает чанки», «пишет события»"
            },
            "протокол": {
              "type": "string",
              "description": "HTTP/JSON, gRPC, SQL, AMQP, Kafka и т.п."
            },
            "критичность": {
              "type": "string",
              "enum": [
                "высокая",
                "средняя",
                "низкая"
              ],
              "description": "egress наружу и границы данных — высокая"
            }
          }
        }
      },
      "легенда": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "обозначение",
            "значение"
          ],
          "properties": {
            "обозначение": {
              "type": "string",
              "description": "стиль, суффикс, форма узла"
            },
            "значение": {
              "type": "string"
            }
          }
        }
      },
      "код_диаграммы": {
        "type": "string",
        "description": "полный исходник в синтаксисе выбранного движка, готовый к рендеру через Kroki; каждая стрелка подписана «действие, протокол»"
      },
      "проверка_синтаксиса": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "статус",
          "замечания"
        ],
        "properties": {
          "статус": {
            "type": "string",
            "enum": [
              "проверено рендером",
              "проверено по правилам синтаксиса",
              "не проверено"
            ]
          },
          "замечания": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "возможные проблемы рендера или спорные конструкции"
          }
        }
      },
      "что_не_показано": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что осознанно вынесено на другой уровень C4 или в другую диаграмму"
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "элементы и связи, добавленные по предположению, а не из данных"
      },
      "открытые_вопросы": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что уточнить у команды: неизвестные протоколы, границы, внешние системы"
      },
      "итог": {
        "type": "string",
        "description": "2–3 предложения: что показывает диаграмма и какие ключевые связи в ней"
      }
    }
  },
  "max_tokens": 5000,
  "inputs": {
    "required": [
      {
        "from": "context",
        "note": "система и уровень схемы: контекст, контейнеры, компоненты"
      }
    ]
  },
  "produces": [
    {
      "path": "элементы",
      "key": "элемент",
      "join": "элемент"
    },
    {
      "path": "связи",
      "key": "от",
      "join": "связь"
    }
  ]
}
