{
  "name": "Аудит 1С · реестр находок A/B/C/D (checks-run)",
  "instruction": "Ты работаешь с РЕЕСТРОМ НАХОДОК, который уже посчитал детерминированный движок (блок ВЫЯВЛЕННЫЕ НАХОДКИ). Не ищи новых и не убирай существующие. Разложи реестр по схеме: сводка по классам, список находок 1:1 с движком (id, класс, проверка, серьёзность, документ, доказательство), пробелы покрытия — как задачи на код. Суммы и номера документов — строго из блока находок и данных, без округлений и домыслов.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "сводка",
      "находки",
      "пробелы_покрытия",
      "итог"
    ],
    "properties": {
      "сводка": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "всего",
          "по_классам",
          "документов_затронуто",
          "период"
        ],
        "properties": {
          "всего": {
            "type": "integer",
            "description": "число находок движка"
          },
          "по_классам": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "A",
              "B",
              "C",
              "D"
            ],
            "properties": {
              "A": {
                "type": "integer",
                "description": "инварианты проводок"
              },
              "B": {
                "type": "integer",
                "description": "разрывы цепочек по basis-ссылкам"
              },
              "C": {
                "type": "integer",
                "description": "НСИ (дубли по ИНН)"
              },
              "D": {
                "type": "integer",
                "description": "нормы: ВГО, переходящие операции"
              }
            }
          },
          "документов_затронуто": {
            "type": "integer",
            "description": "уникальные документы из находок"
          },
          "период": {
            "type": "string",
            "description": "диапазон дат документов в находках, ГГГГ-ММ-ДД — ГГГГ-ММ-ДД"
          }
        }
      },
      "находки": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "класс",
            "проверка",
            "серьёзность",
            "документ",
            "сумма",
            "описание",
            "доказательство",
            "участок_от",
            "участок_до"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "id находки движка, напр. B1-РТ-0002"
            },
            "класс": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "проверка": {
              "type": "string",
              "description": "название проверки как у движка"
            },
            "серьёзность": {
              "type": "string",
              "enum": [
                "высокая",
                "средняя",
                "низкая"
              ]
            },
            "документ": {
              "type": "string",
              "description": "тип № от даты · контрагент; для НСИ — ИНН и карточки"
            },
            "сумма": {
              "type": "string",
              "description": "сумма документа как в данных, с ₽; пусто если неприменимо"
            },
            "описание": {
              "type": "string",
              "description": "суть нарушения человеческим языком, 1–2 предложения"
            },
            "доказательство": {
              "type": "string",
              "description": "проверяемая ссылка: отсутствующий документ-основание, коды Дт/Кт, ИНН, даты"
            },
            "участок_от": {
              "type": "string",
              "description": "участок учёта, где возникла операция (Реализация, Поступление, Банк, НСИ)"
            },
            "участок_до": {
              "type": "string",
              "description": "участок, где не сошлось (НДС, Взаиморасчёты, Себестоимость, Консолидация)"
            }
          }
        }
      },
      "пробелы_покрытия": {
        "type": "array",
        "description": "что движок НЕ проверяет, но по данным стоило бы — как задача на код, не как находка",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "проверка",
            "почему"
          ],
          "properties": {
            "проверка": {
              "type": "string"
            },
            "почему": {
              "type": "string"
            }
          }
        }
      },
      "итог": {
        "type": "string",
        "description": "2–3 предложения: сколько находок, какие классы доминируют, что передаётся дальше (root-cause/rank)"
      }
    }
  },
  "inputs": {
    "required": [
      {
        "from": "data",
        "entity": "doc1c",
        "fields": [
          "id",
          "тип",
          "СуммаДокумента",
          "Проводки"
        ]
      },
      {
        "from": "skill",
        "skill": "audit1c-graph-build",
        "path": "документы_по_типам",
        "fields": [
          "тип"
        ]
      }
    ],
    "optional": [
      {
        "from": "data",
        "entity": "ref1c",
        "fields": [
          "id",
          "ИНН",
          "Наименование"
        ]
      }
    ]
  },
  "produces": [
    {
      "path": "находки",
      "key": "id",
      "join": "находка"
    },
    {
      "path": "пробелы_покрытия",
      "key": "id",
      "join": "пробел"
    }
  ]
}
