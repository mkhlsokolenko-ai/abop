{
  "name": "Письмо заказчику (client-letter)",
  "instruction": "Составь деловое письмо заказчику по плану на день: что взято в работу, что будет сделано сегодня, сроки, что нужно от заказчика. Только факты из плана и писем, без обещаний сверх плана и без воды. Письмо — черновик под подтверждение человека; поле требуется_подтверждение всегда true.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "кому",
      "тема",
      "приветствие",
      "в_работе",
      "план_на_сегодня",
      "сроки",
      "нужно_от_вас",
      "подпись",
      "текст_письма",
      "требуется_подтверждение"
    ],
    "properties": {
      "кому": {
        "type": "string",
        "description": "адресат из данных (отправитель исходного письма) или роль"
      },
      "тема": {
        "type": "string",
        "description": "до 80 символов"
      },
      "приветствие": {
        "type": "string"
      },
      "в_работе": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "задача",
            "статус"
          ],
          "properties": {
            "задача": {
              "type": "string"
            },
            "статус": {
              "type": "string",
              "enum": [
                "взято в работу",
                "в процессе",
                "ждём данных"
              ]
            }
          }
        }
      },
      "план_на_сегодня": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "сроки": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "что",
            "когда"
          ],
          "properties": {
            "что": {
              "type": "string"
            },
            "когда": {
              "type": "string",
              "description": "ГГГГ-ММ-ДД или «сегодня до 18:00»"
            }
          }
        }
      },
      "нужно_от_вас": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "вопросы/данные, которых не хватает; пусто, если всё есть"
      },
      "подпись": {
        "type": "string"
      },
      "текст_письма": {
        "type": "string",
        "description": "готовый текст письма целиком, 80–160 слов, деловой тон, абзацы через пустую строку"
      },
      "требуется_подтверждение": {
        "type": "boolean"
      }
    }
  },
  "delivery": {
    "system": "mailpit",
    "type": "email.send",
    "limit": 1,
    "title": "Письмо заказчику: {{тема}}",
    "payload": {
      "to": "{{кому}}",
      "subject": "{{тема}}",
      "body": "{{приветствие}}\n\n{{текст_письма}}\n\nВ работе:\n{{#в_работе}}\n\nПлан на сегодня:\n{{#план_на_сегодня}}\n\nСроки:\n{{#сроки}}\n\nНужно от вас:\n{{#нужно_от_вас}}\n\n{{подпись}}"
    }
  }
}
