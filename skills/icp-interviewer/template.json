{
  "name": "Интервью с представителем ICP (icp-interviewer)",
  "instruction": "По описанию ICP, продуктовой канве и результатам discovery из блока данных сыграй занятого практика-представителя ICP: зафиксируй образ (роль, контекст, боль, бюджет), ответь на вопросы студента честно и с сопротивлением, задай проверочные вопросы (как решает сейчас, сколько стоит, топ-3 ли боль), подсвети красные флаги и вынеси вердикт по гипотезе ценности с тем, что менять. Всё, что не дано в описании образа, — только правдоподобная гипотеза, явно помеченная как гипотеза; не выдумывай боль и цифры «за ICP»; чего нет в данных — «не удалось определить».",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "образ_icp",
      "гипотеза_ценности",
      "диалог",
      "проверочные_вопросы",
      "красные_флаги",
      "возражения",
      "вердикт",
      "что_менять",
      "допущения",
      "открытые_вопросы_студенту",
      "итог"
    ],
    "properties": {
      "образ_icp": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "роль",
          "контекст",
          "боль",
          "бюджет",
          "как_решает_сейчас",
          "источник",
          "пробелы_в_образе"
        ],
        "properties": {
          "роль": {
            "type": "string"
          },
          "контекст": {
            "type": "string",
            "description": "где и как работает, что окружает"
          },
          "боль": {
            "type": "string",
            "description": "формулировка боли из данных"
          },
          "бюджет": {
            "type": "string",
            "description": "строкой или «не удалось определить»"
          },
          "как_решает_сейчас": {
            "type": "string",
            "description": "текущее решение: Excel, вручную, конкурент"
          },
          "источник": {
            "type": "string",
            "description": "описание студента, профиль ICP, discovery"
          },
          "пробелы_в_образе": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "что не задано студентом и додумано как гипотеза"
          }
        }
      },
      "гипотеза_ценности": {
        "type": "string",
        "description": "что проверяем, одной фразой из канвы"
      },
      "диалог": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "вопрос_студента",
            "ответ_icp",
            "основание",
            "сигнал"
          ],
          "properties": {
            "вопрос_студента": {
              "type": "string"
            },
            "ответ_icp": {
              "type": "string",
              "description": "от первого лица, как занятой практик"
            },
            "основание": {
              "type": "string",
              "enum": [
                "из данных образа",
                "гипотеза"
              ]
            },
            "сигнал": {
              "type": "string",
              "enum": [
                "подтверждает",
                "опровергает",
                "нейтрально"
              ]
            }
          }
        }
      },
      "проверочные_вопросы": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "вопрос",
            "ответ_icp",
            "основание"
          ],
          "properties": {
            "вопрос": {
              "type": "string",
              "enum": [
                "как решаешь это сейчас",
                "сколько времени и денег это стоит",
                "это топ-3 боль",
                "сколько готов платить",
                "почему не конкурент"
              ]
            },
            "ответ_icp": {
              "type": "string"
            },
            "основание": {
              "type": "string",
              "enum": [
                "из данных образа",
                "гипотеза"
              ]
            }
          }
        }
      },
      "красные_флаги": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "флаг",
            "обнаружен",
            "обоснование"
          ],
          "properties": {
            "флаг": {
              "type": "string",
              "enum": [
                "витаминка, а не обезболивающее",
                "боль не у того, кто платит",
                "влюблённость в решение, а не в проблему",
                "боли нет у образа",
                "нет бюджета"
              ]
            },
            "обнаружен": {
              "type": "boolean"
            },
            "обоснование": {
              "type": "string"
            }
          }
        }
      },
      "возражения": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "ключевые возражения ICP против продукта"
      },
      "вердикт": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "гипотеза",
          "уверенность",
          "обоснование",
          "критичность"
        ],
        "properties": {
          "гипотеза": {
            "type": "string",
            "enum": [
              "подтверждена",
              "частично подтверждена",
              "не подтверждена",
              "недостаточно данных"
            ]
          },
          "уверенность": {
            "type": "string",
            "enum": [
              "высокая",
              "средняя",
              "низкая"
            ]
          },
          "обоснование": {
            "type": "string"
          },
          "критичность": {
            "type": "string",
            "enum": [
              "высокая",
              "средняя",
              "низкая"
            ],
            "description": "высокая — если неподтверждённая гипотеза ключевая для go/no-go"
          }
        }
      },
      "что_менять": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "изменение",
            "основание",
            "приоритет"
          ],
          "properties": {
            "изменение": {
              "type": "string",
              "description": "в проблеме, ICP, ценности или канале"
            },
            "приоритет": {
              "type": "string",
              "enum": [
                "высокий",
                "средний",
                "низкий"
              ]
            },
            "основание": {
              "type": "string"
            }
          }
        }
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "гипотезы «за ICP», принятые в ходе интервью"
      },
      "открытые_вопросы_студенту": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что нужно проверить на реальных интервью"
      },
      "итог": {
        "type": "string",
        "description": "2–3 предложения: вердикт и главное, что менять"
      }
    }
  },
  "max_tokens": 4000,
  "inputs": {
    "required": [
      {
        "from": "context",
        "note": "профиль клиента и гипотеза, которую проверяем"
      }
    ]
  },
  "produces": [
    {
      "path": "проверочные_вопросы",
      "key": "вопрос",
      "join": "вопрос"
    }
  ]
}
