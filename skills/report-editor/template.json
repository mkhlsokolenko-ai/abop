{
  "name": "Редактор отчёта (report-editor)",
  "instruction": "Ты складываешь ОДИН документ из разделов, которые отдали навыки прогона, и сверяешь его с задачей человека. Выбирай ВИД, а не содержание: объяви порядок разделов, заголовки и ссылки на поля — значения подставит движок отчёта дословно. Ссылку всегда пришпиливай к навыку («idea-scorer:вердикт»), иначе графа возьмёт одноимённое поле у другого навыка. Начинай с того, за чем документ открывают: решение, вердикт, главные числа; подробности и перечни — ниже. Раздел навыка, который не отвечает задаче, НЕ выбрасывай: перечисли такие в «лишнее» и скажи в сверке. Чего в прогоне нет — пиши в «не_покрыто» с причиной, не придумывай ни полей, ни значений.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "раскладка",
      "сверка_с_задачей",
      "итог"
    ],
    "properties": {
      "раскладка": {
        "type": "array",
        "description": "порядок разделов итогового документа; значения берутся по ссылкам, не пишутся",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "type": "string",
              "enum": [
                "part",
                "attrs",
                "verdict",
                "kpi",
                "prose",
                "list",
                "cards",
                "register",
                "pre",
                "note",
                "sign"
              ],
              "description": "тип блока"
            },
            "title": {
              "type": "string",
              "description": "заголовок раздела или графы"
            },
            "sub": {
              "type": "string",
              "description": "подпись под заголовком части"
            },
            "src": {
              "type": "string",
              "description": "ссылка на поле: «навык:путь»"
            },
            "badge": {
              "type": "string",
              "description": "ссылка на поле бейджа решения"
            },
            "why": {
              "type": "string",
              "description": "ссылка на поле основания"
            },
            "text": {
              "type": "string",
              "description": "текст оговорки (только для note)"
            },
            "rows": {
              "type": "array",
              "items": {},
              "description": "графы: [подпись, ссылка] или подписи для sign"
            },
            "meta": {
              "type": "array",
              "items": {},
              "description": "графы шапки: [подпись, ссылка]"
            },
            "cols": {
              "type": "array",
              "items": {},
              "description": "колонки реестра: [подпись, графа элемента]"
            },
            "graphs": {
              "type": "array",
              "items": {},
              "description": "графы карточки: [подпись, графа элемента]"
            },
            "head": {
              "type": "string",
              "description": "графа элемента для заголовка карточки"
            },
            "code": {
              "type": "string",
              "description": "графа элемента для кода карточки"
            },
            "group": {
              "type": "string",
              "description": "подпись группы в шапке карточки"
            }
          }
        }
      },
      "сверка_с_задачей": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "покрыто",
          "не_покрыто",
          "вывод"
        ],
        "properties": {
          "покрыто": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "что_просили",
                "чем_закрыто"
              ],
              "properties": {
                "что_просили": {
                  "type": "string"
                },
                "чем_закрыто": {
                  "type": "string",
                  "description": "навык и раздел"
                }
              }
            }
          },
          "не_покрыто": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "что_просили",
                "почему"
              ],
              "properties": {
                "что_просили": {
                  "type": "string"
                },
                "почему": {
                  "type": "string",
                  "description": "нет навыка, нет данных, навык не заполнил"
                }
              }
            }
          },
          "вывод": {
            "type": "string",
            "description": "задача закрыта / закрыта частично / не закрыта — и чем это видно"
          }
        }
      },
      "лишнее": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "разделы, которых задача не просила; они остаются в документе, но помечены"
      },
      "итог": {
        "type": "string",
        "description": "одна фраза: что за документ собран и чего в нём нет"
      }
    }
  },
  "max_tokens": 2600,
  "inputs": {
    "required": [
      {
        "from": "run",
        "what": "skill_outputs",
        "note": "все разделы прогона: без них документ не сложить"
      },
      {
        "from": "context",
        "note": "задача человека — с ней и сверяем"
      }
    ]
  },
  "produces": [
    {
      "path": "раскладка",
      "join": "раскладка_отчёта"
    },
    {
      "path": "сверка_с_задачей",
      "join": "сверка_с_задачей"
    }
  ]
}
