    "type": "object",
    "additionalProperties": false,
    "required": [
      "цель",
      "дерево_метрик",
      "причинные_связи",
      "слой_exec",
      "слой_ops",
      "guardrail_пороги",
      "отсеянные_vanity",
      "без_источника",
      "допущения",
      "итог"
    ],
    "properties": {
