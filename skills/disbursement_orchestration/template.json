          },
          "disbursement_id": {
            "type": "string",
            "description": "id операции в core-banking или «—»"
          },
          "оператор": {
            "type": "string",
            "description": "кто дал approve"
          },
          "дата_approve": {
            "type": "string",
            "description": "ГГГГ-ММ-ДД ЧЧ:ММ или «—»"
          },
          "проведённая_сумма": {
            "type": "string",
            "description": "с валютой или «—»"
          },
          "расхождение_с_намерением": {
            "type": "string",
            "description": "сумма расхождения или «нет»"
          }
        },
        "description": "заполняется по данным о факте проведения; иначе не_проводилось"
      },
      "идемпотентность": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ключ",
          "признак_дубля",
          "комментарий"
        ],
        "properties": {
          "ключ": {
            "type": "string",
            "description": "по чему определяется повтор: заявка+договор+сумма или id"
          },
          "признак_дубля": {
            "type": "string",
            "enum": [
              "дубль_не_найден",
              "найден_дубль",
              "не удалось определить"
            ]
          },
          "комментарий": {
            "type": "string"
          }
        }
      },
      "эскалации": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что требует остановки и передачи человеку"
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "итог": {
        "type": "string",
        "description": "2–4 предложения: готовность к approve, ключевые проверки, что дальше (ledger_reconciliation / period_close)"
      }
    }
