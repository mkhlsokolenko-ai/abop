            "статус",
            "основание"
          ],
          "properties": {
            "условие": {
              "type": "string",
              "enum": [
                "вердикт_approved",
                "договор_подписан",
                "реквизиты_верифицированы",
                "сумма_в_лимите",
                "нет_стоп_факторов",
                "нет_двойной_выдачи"
              ]
            },
            "статус": {
              "type": "string",
              "enum": [
                "пройдено",
                "не_пройдено",
                "не удалось определить"
              ]
            },
            "основание": {
              "type": "string",
              "description": "поле/документ/запись, по которой проверено"
            }
          }
        },
        "description": "hard-gates перед подготовкой выдачи; все шесть"
      },
