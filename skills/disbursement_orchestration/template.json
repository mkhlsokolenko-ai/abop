              "да",
              "нет",
              "не удалось определить"
            ]
          },
          "одобренный_лимит": {
            "type": "string",
            "description": "с валютой, из вердикта limit_policy_enforcement"
          },
          "источник": {
            "type": "string",
            "description": "сущность/id записи с условиями выдачи"
          }
        }
      },
      "пред_условия": {
        "type": "array",
        "items": {
