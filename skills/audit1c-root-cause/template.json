{
  "name": "Аудит 1С · первопричины (root-cause)",
  "instruction": "Сгруппируй находки из блока ВЫЯВЛЕННЫЕ НАХОДКИ по процессам-причинам. Для каждой причины: гипотеза процесса, подтверждение фактами графа (сколько документов, какие контрагенты, какой период), охват в находках, отличие корня от симптома. Не пересказывай реестр плоско и не сливай разные причины в «плохой учёт». Все числа и id — из блока находок.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "причины",
      "необъяснённые_находки",
      "итог"
    ],
    "properties": {
      "причины": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "причина",
            "процесс",
            "гипотеза",
            "подтверждение",
            "охват",
            "находки",
            "контрагенты",
            "период",
            "приоритет",
            "что_изменить"
          ],
          "properties": {
            "причина": {
              "type": "string",
              "description": "короткое название, напр. «Счета-фактуры не выставляются по реализации»"
            },
            "процесс": {
              "type": "string",
              "description": "участок/процесс учёта: НДС, взаиморасчёты, банк, НСИ, консолидация, закрытие периода"
            },
            "гипотеза": {
              "type": "string",
              "description": "почему это происходит (регламент, роли, настройка 1С, дисциплина ввода)"
            },
            "подтверждение": {
              "type": "string",
              "description": "факты из графа: сколько документов, какие типы, суммы"
            },
            "охват": {
              "type": "integer",
              "description": "сколько находок объясняет причина"
            },
            "находки": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "id находок"
            },
            "контрагенты": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "период": {
              "type": "string",
              "description": "ГГГГ-ММ — ГГГГ-ММ"
            },
            "приоритет": {
              "type": "string",
              "enum": [
                "высокий",
                "средний",
                "низкий"
              ],
              "description": "по охвату × риску"
            },
            "что_изменить": {
              "type": "string",
              "description": "конкретное изменение процесса/настройки, устраняющее корень"
            }
          }
        }
      },
      "необъяснённые_находки": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "id находок, не вошедших ни в одну причину"
      },
      "итог": {
        "type": "string",
        "description": "какие 1–3 причины закрывают большинство находок"
      }
    }
  },
  "max_tokens": 4000,
  "inputs": {
    "required": [
      {
        "from": "skill",
        "skill": "audit1c-checks",
        "path": "находки",
        "fields": [
          "id",
          "класс",
          "критичность"
        ]
      }
    ]
  },
  "produces": {
    "path": "причины",
    "key": "id",
    "join": "первопричина"
  }
}
