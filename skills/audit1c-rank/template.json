{
  "name": "Аудит 1С · ранжирование по существенности (rank)",
  "instruction": "Ранжируй находки из блока ВЫЯВЛЕННЫЕ НАХОДКИ по существенности: сумма влияния × налоговый/нормативный риск × охват. Суммы — только из данных/находок (СуммаДокумента, НДС), не прикидывай. Порог существенности выведи из данных (например, медиана сумм документов) и назови его. Формальное не выдавай за критичное, крупное и нормативное не прячь вниз.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "порог_существенности",
      "рейтинг",
      "топ_3_действия",
      "итог"
    ],
    "properties": {
      "порог_существенности": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "сумма",
          "как_выведен"
        ],
        "properties": {
          "сумма": {
            "type": "string",
            "description": "порог в ₽"
          },
          "как_выведен": {
            "type": "string"
          }
        }
      },
      "рейтинг": {
        "type": "array",
        "description": "от самого существенного к формальному",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "место",
            "id",
            "ранг",
            "сумма_влияния",
            "риск",
            "охват",
            "обоснование"
          ],
          "properties": {
            "место": {
              "type": "integer"
            },
            "id": {
              "type": "string",
              "description": "id находки"
            },
            "ранг": {
              "type": "string",
              "enum": [
                "критично",
                "существенно",
                "умеренно",
                "формально"
              ]
            },
            "сумма_влияния": {
              "type": "string",
              "description": "сумма в ₽ из данных; «—» если неприменимо"
            },
            "риск": {
              "type": "string",
              "enum": [
                "налоговый",
                "отчётность",
                "расчёты",
                "НСИ",
                "период"
              ]
            },
            "охват": {
              "type": "integer",
              "description": "сколько документов/находок затрагивает (из root-cause, если есть)"
            },
            "обоснование": {
              "type": "string",
              "description": "почему именно этот ранг: сумма + риск + охват"
            }
          }
        }
      },
      "топ_3_действия": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "три первых действия для менеджмента"
      },
      "итог": {
        "type": "string"
      }
    }
  },
  "max_tokens": 4000,
  "delivery": {
    "system": "redmine",
    "type": "issue.create",
    "title": "Задача Redmine: рейтинг находок и топ-3 действия",
    "payload": {
      "subject": "Аудит 1С · рейтинг находок по существенности · порог {{порог_существенности.сумма}}",
      "description": "h2. Порог существенности\n\n{{порог_существенности.сумма}} — {{порог_существенности.как_выведен}}\n\nh2. Рейтинг (от самого существенного)\n\n{{#рейтинг}}\n\nh2. Топ-3 действия для менеджмента\n\n{{#топ_3_действия}}\n\nh2. Итог\n\n{{итог}}\n\n---\nСформировано ABOP (навык audit1c-rank)."
    }
  },
  "inputs": {
    "required": [
      {
        "from": "skill",
        "skill": "audit1c-checks",
        "path": "находки",
        "fields": [
          "id",
          "сумма",
          "критичность"
        ]
      }
    ],
    "optional": [
      {
        "from": "skill",
        "skill": "audit1c-root-cause",
        "path": "причины",
        "fields": [
          "id"
        ]
      },
      {
        "from": "data",
        "entity": "doc1c",
        "note": "суммы и реквизиты документов для оценки существенности"
      }
    ]
  },
  "produces": {
    "path": "рейтинг",
    "key": "id",
    "join": "находка"
  }
}
