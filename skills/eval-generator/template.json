{
  "name": "Eval-датасет и грейдеры (eval-generator)",
  "instruction": "По спеке с acceptance-критериями, корпусу и seed-датасету из блока данных собери eval: каждому критерию 3–10 кейсов вход/ожидание, включая негативы (модель должна отказать или сработать fallback), тип грейдера под кейс (code / LLM-as-judge / human) с обоснованием, метрики и пороги. Входы и ожидания бери из реальных данных и спеки; если данных для кейса нет — укажи пробел, не подставляй придуманный ответ. Пороги без калибровки на seed-датасете помечай как предварительные; предположения — в допущениях.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "источники",
      "критерии_приёмки",
      "кейсы",
      "грейдеры",
      "метрики",
      "покрытие",
      "воспроизводимость",
      "допущения",
      "открытые_вопросы",
      "итог"
    ],
    "properties": {
      "источники": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "спека",
          "корпус",
          "seed_датасет"
        ],
        "properties": {
          "спека": {
            "type": "string",
            "description": "название или id документа со спекой"
          },
          "корпус": {
            "type": "string",
            "description": "что использовано как корпус или «нет данных»"
          },
          "seed_датасет": {
            "type": "string",
            "description": "что использовано для калибровки или «нет данных»"
          }
        }
      },
      "критерии_приёмки": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "критерий",
            "тип_грейдера",
            "обоснование_грейдера",
            "число_кейсов"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "AC-1, AC-2…"
            },
            "критерий": {
              "type": "string",
              "description": "проверяемая формулировка из спеки"
            },
            "тип_грейдера": {
              "type": "string",
              "enum": [
                "code",
                "LLM-as-judge",
                "human"
              ]
            },
            "обоснование_грейдера": {
              "type": "string",
              "description": "почему этот тип: есть точный ответ / нужна оценка качества / нужен эксперт"
            },
            "число_кейсов": {
              "type": "integer",
              "description": "сколько кейсов покрывает критерий в этом датасете"
            }
          }
        }
      },
      "кейсы": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "критерий_id",
            "тип",
            "вход",
            "ожидание",
            "грейдер",
            "источник"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "E-1, E-2…"
            },
            "критерий_id": {
              "type": "string",
              "description": "к какому AC относится"
            },
            "тип": {
              "type": "string",
              "enum": [
                "позитив",
                "негатив",
                "граница"
              ],
              "description": "негатив — модель должна отказать или сработать fallback"
            },
            "вход": {
              "type": "string",
              "description": "входные данные кейса"
            },
            "ожидание": {
              "type": "string",
              "description": "ожидаемый ответ или проверяемый критерий для судьи"
            },
            "грейдер": {
              "type": "string",
              "enum": [
                "code",
                "LLM-as-judge",
                "human"
              ]
            },
            "источник": {
              "type": "string",
              "description": "откуда взят вход/ожидание: спека, корпус, seed; или «пробел — нет данных»"
            }
          }
        }
      },
      "грейдеры": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "название",
            "тип",
            "что_проверяет",
            "реализация",
            "модель",
            "версия_промпта"
          ],
          "properties": {
            "название": {
              "type": "string"
            },
            "тип": {
              "type": "string",
              "enum": [
                "code",
                "LLM-as-judge",
                "human"
              ]
            },
            "что_проверяет": {
              "type": "string",
              "description": "один критерий — одна проверка"
            },
            "реализация": {
              "type": "string",
              "description": "сравнение/функция для code, текст критерия судьи для judge, инструкция разметчику для human"
            },
            "модель": {
              "type": "string",
              "description": "для judge: дешёвая модель, профиль research; иначе пустая строка"
            },
            "версия_промпта": {
              "type": "string",
              "description": "prompt_version для judge; иначе пустая строка"
            }
          }
        }
      },
      "метрики": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "метрика",
            "как_считается",
            "целевой_порог",
            "статус_порога"
          ],
          "properties": {
            "метрика": {
              "type": "string",
              "description": "Recall@K, доля без цитат, точность классификации, pass-rate judge"
            },
            "как_считается": {
              "type": "string"
            },
            "целевой_порог": {
              "type": "string",
              "description": "значение строкой"
            },
            "статус_порога": {
              "type": "string",
              "enum": [
                "откалиброван на seed",
                "предварительный",
                "не удалось определить"
              ]
            }
          }
        }
      },
      "покрытие": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "критериев_всего",
          "критериев_покрыто",
          "есть_негативы",
          "пробелы"
        ],
        "properties": {
          "критериев_всего": {
            "type": "integer"
          },
          "критериев_покрыто": {
            "type": "integer",
            "description": "с 3 и более кейсами"
          },
          "есть_негативы": {
            "type": "boolean"
          },
          "пробелы": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "критерии и кейсы, для которых не хватило данных"
          }
        }
      },
      "воспроизводимость": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "промпт_судьи_версионирован",
          "детерминированность",
          "расположение_датасета"
        ],
        "properties": {
          "промпт_судьи_версионирован": {
            "type": "boolean"
          },
          "детерминированность": {
            "type": "string",
            "description": "как обеспечивается одинаковый вердикт на одном входе"
          },
          "расположение_датасета": {
            "type": "string",
            "description": "путь вида eval/<имя>.jsonl"
          }
        }
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "открытые_вопросы": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что уточнить в спеке: неясные критерии, отсутствующие данные"
      },
      "итог": {
        "type": "string",
        "description": "2–3 предложения: сколько кейсов, какие грейдеры, что ещё нужно для калибровки"
      }
    }
  },
  "max_tokens": 4000
}
