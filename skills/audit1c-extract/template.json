{
  "name": "Аудит 1С · контроль извлечения снапшота (extract)",
  "instruction": "Проверь по дайджесту Data Plane, что снапшот 1С приехал полностью: сущности doc1c/ref1c, типы документов и справочников, объёмы, заполненность ключевых ссылок (Организация_uuid, Контрагент_uuid, Основание_uuid), провенанс. Не выдумывай числа — только из дайджеста (всего/по_типам) и результатов инструментов. Сбой сети или пустой рецепт — это сбой извлечения, а не «нет данных».",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "сущности",
      "ключевые_ссылки",
      "провенанс",
      "статус",
      "проблемы",
      "итог"
    ],
    "properties": {
      "сущности": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "сущность",
            "записей",
            "типы",
            "ожидалось"
          ],
          "properties": {
            "сущность": {
              "type": "string",
              "enum": [
                "doc1c",
                "ref1c"
              ]
            },
            "записей": {
              "type": "integer"
            },
            "типы": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "тип",
                  "количество"
                ],
                "properties": {
                  "тип": {
                    "type": "string"
                  },
                  "количество": {
                    "type": "integer"
                  }
                }
              }
            },
            "ожидалось": {
              "type": "string",
              "description": "какие типы обязаны быть (Поступление, Реализация, СчётФактура×2, банк / Организации, Контрагенты, Счета, Договоры, Номенклатура)"
            }
          }
        }
      },
      "ключевые_ссылки": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "организация_заполнена",
          "контрагент_заполнен",
          "основание_заполнено_у_цепочечных",
          "комментарий"
        ],
        "properties": {
          "организация_заполнена": {
            "type": "string",
            "description": "доля или «все/не все» по сэмплу"
          },
          "контрагент_заполнен": {
            "type": "string"
          },
          "основание_заполнено_у_цепочечных": {
            "type": "string"
          },
          "комментарий": {
            "type": "string"
          }
        }
      },
      "провенанс": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "рецепты",
          "источник",
          "период_снапшота"
        ],
        "properties": {
          "рецепты": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "источник": {
            "type": "string"
          },
          "период_снапшота": {
            "type": "string"
          }
        }
      },
      "статус": {
        "type": "string",
        "enum": [
          "полный",
          "частичный",
          "сбой"
        ]
      },
      "проблемы": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "итог": {
        "type": "string"
      }
    }
  },
  "inputs": {
    "required": [
      {
        "from": "data",
        "entity": "doc1c",
        "fields": [
          "id",
          "тип",
          "Номер",
          "Дата",
          "Проводки"
        ]
      },
      {
        "from": "data",
        "entity": "ref1c",
        "fields": [
          "id",
          "тип",
          "Наименование",
          "ИНН"
        ]
      }
    ]
  },
  "produces": {
    "path": "сущности",
    "key": "сущность",
    "join": "сущность1с"
  }
}
