{
  "name": "Выбор архитектуры: workflow vs agent (architecture-chooser)",
  "instruction": "По описанию задачи, требований и ограничений домена из блока данных пройди четыре критерия — сложность, ценность, выполнимость, цена ошибки — и выбери уровень: один LLM-вызов, workflow, agent или hybrid. Дефолт — самый простой уровень, который решает задачу; явно покажи, почему уровень проще не подходит. Для agent/hybrid перечисли переходы, остающиеся под контролем кода. Оценки по критериям опирай только на факты из данных; чего нет — «не удалось определить», предположения помечай в допущениях.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "задача",
      "критерии",
      "выбор",
      "проверка_простого_уровня",
      "отвергнутые_варианты",
      "контроль_кода",
      "риски",
      "для_adr",
      "следующий_шаг",
      "допущения",
      "открытые_вопросы",
      "итог"
    ],
    "properties": {
      "задача": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "название",
          "описание",
          "домен",
          "источник"
        ],
        "properties": {
          "название": {
            "type": "string"
          },
          "описание": {
            "type": "string",
            "description": "что должно получаться на выходе, 1–3 предложения"
          },
          "домен": {
            "type": "string",
            "description": "предметная область и регуляторика, если есть в данных"
          },
          "источник": {
            "type": "string",
            "description": "документ, задача, обсуждение"
          }
        }
      },
      "критерии": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "критерий",
            "факты",
            "оценка",
            "в_пользу"
          ],
          "properties": {
            "критерий": {
              "type": "string",
              "enum": [
                "сложность",
                "ценность",
                "выполнимость",
                "цена ошибки"
              ]
            },
            "факты": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "факты из данных, на которых основана оценка"
            },
            "оценка": {
              "type": "string",
              "description": "вывод по критерию, 1–2 предложения"
            },
            "в_пользу": {
              "type": "string",
              "enum": [
                "один LLM-вызов",
                "workflow",
                "agent",
                "hybrid",
                "не удалось определить"
              ],
              "description": "какой уровень поддерживает этот критерий"
            }
          }
        },
        "description": "ровно четыре критерия, по одному объекту на каждый"
      },
      "выбор": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "уровень",
          "обоснование",
          "уверенность"
        ],
        "properties": {
          "уровень": {
            "type": "string",
            "enum": [
              "один LLM-вызов",
              "workflow",
              "agent",
              "hybrid"
            ]
          },
          "обоснование": {
            "type": "string",
            "description": "почему этот уровень, со ссылкой на критерии"
          },
          "уверенность": {
            "type": "string",
            "enum": [
              "высокая",
              "средняя",
              "низкая"
            ],
            "description": "уверенность вывода по данным"
          }
        }
      },
      "проверка_простого_уровня": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "уровень_проще",
          "почему_не_подходит"
        ],
        "properties": {
          "уровень_проще": {
            "type": "string",
            "description": "ближайший более простой уровень или «нет — выбран самый простой»"
          },
          "почему_не_подходит": {
            "type": "string",
            "description": "конкретная причина, а не «недостаточно гибко»"
          }
        }
      },
      "отвергнутые_варианты": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "уровень",
            "почему_отвергли"
          ],
          "properties": {
            "уровень": {
              "type": "string",
              "enum": [
                "один LLM-вызов",
                "workflow",
                "agent",
                "hybrid"
              ]
            },
            "почему_отвергли": {
              "type": "string"
            }
          }
        }
      },
      "контроль_кода": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "переход",
            "основание",
            "необратимое_действие"
          ],
          "properties": {
            "переход": {
              "type": "string",
              "description": "шаг или развилка, зашитая в код"
            },
            "необратимое_действие": {
              "type": "boolean",
              "description": "true, если переход ведёт к необратимому действию и нужен HITL"
            },
            "основание": {
              "type": "string",
              "description": "аудируемость, необратимость, регуляторика"
            }
          }
        },
        "description": "для agent/hybrid; для остальных уровней пусто"
      },
      "риски": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "риск",
            "влияние",
            "смягчение"
          ],
          "properties": {
            "риск": {
              "type": "string"
            },
            "влияние": {
              "type": "string",
              "enum": [
                "высокая",
                "средняя",
                "низкая"
              ]
            },
            "смягчение": {
              "type": "string"
            }
          }
        }
      },
      "для_adr": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "название_решения",
          "контекст_кратко",
          "последствия"
        ],
        "properties": {
          "название_решения": {
            "type": "string",
            "description": "заголовок будущего ADR"
          },
          "контекст_кратко": {
            "type": "string",
            "description": "силы и ограничения, 1–2 предложения"
          },
          "последствия": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "чем платим за выбранный уровень"
          }
        }
      },
      "следующий_шаг": {
        "type": "string",
        "enum": [
          "agent-design-writer",
          "adr-writer",
          "реализация workflow",
          "уточнить требования"
        ]
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "открытые_вопросы": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что уточнить, чтобы подтвердить выбор"
      },
      "итог": {
        "type": "string",
        "description": "2–3 предложения: выбранный уровень и главная причина"
      }
    }
  },
  "max_tokens": 4000,
  "inputs": {
    "required": [
      {
        "from": "context",
        "note": "задача выбора: что решаем, какие ограничения"
      }
    ]
  },
  "produces": [
    {
      "path": "критерии",
      "key": "критерий",
      "join": "критерий_выбора"
    }
  ]
}
