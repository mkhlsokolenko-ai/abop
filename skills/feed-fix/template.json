                "required": [
                  "поле",
                  "было",
                  "стало",
                  "основание"
                ],
                "properties": {
                  "поле": {
                    "type": "string"
                  },
                  "было": {
                    "type": "string"
                  },
                  "стало": {
                    "type": "string"
                  },
                  "основание": {
                    "type": "string",
                    "description": "правило витрины или поле данных, из которого выведено"
                  }
                }
              }
            },
            "категория_предложение": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "категория_витрины",
                "на_чём_основано"
              ],
              "properties": {
                "категория_витрины": {
                  "type": "string"
                },
                "на_чём_основано": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "нужен_человек": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "карточка",
            "что_нужно"
          ],
          "properties": {
            "карточка": {
              "type": "string"
            },
            "что_нужно": {
              "type": "string",
              "description": "снимки, маркировка, решение по категории — конкретно"
            }
          }
        }
      },
      "нужны_данные_поставщика": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "карточка",
            "поле",
            "запрос"
          ],
          "properties": {
            "карточка": {
              "type": "string"
            },
            "поле": {
              "type": "string"
            },
            "запрос": {
              "type": "string",
              "description": "что именно запросить; значение не придумывается"
            }
          }
        }
      },
      "итог": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "уходит_сразу",
          "ждёт_человека",
          "ждёт_поставщика"
        ],
        "properties": {
          "уходит_сразу": {
            "type": "integer"
          },
          "ждёт_человека": {
            "type": "integer"
          },
          "ждёт_поставщика": {
            "type": "integer"
          }
        }
      }
    }
  },
  "produces": [
    {
      "path": "кандидаты",
      "key": "карточка",
      "join": "карточка"
    },
    {
      "path": "нужен_человек",
      "key": "карточка",
      "join": "карточка"
    }
  ],
  "inputs": {
