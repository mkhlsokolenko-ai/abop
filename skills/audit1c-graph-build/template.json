{
  "name": "Аудит 1С · сводка графа связей (graph-build)",
  "instruction": "Опиши граф связей 1С по данным дайджеста и результату инструмента audit1c_graph: узлы по типам документов, basis-рёбра, индекс счетов, индексы ИНН, оценка связности. Ничего не достраивай: связь либо есть в данных (uuid/ИНН/код), либо нет. Числа — из данных и сводки инструмента.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "документы_по_типам",
      "рёбра_основание",
      "план_счетов",
      "организации",
      "контрагенты",
      "связность",
      "аномалии_извлечения",
      "итог"
    ],
    "properties": {
      "документы_по_типам": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "тип",
            "количество"
          ],
          "properties": {
            "тип": {
              "type": "string"
            },
            "количество": {
              "type": "integer"
            }
          }
        }
      },
      "рёбра_основание": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "всего",
          "по_виду"
        ],
        "properties": {
          "всего": {
            "type": "integer"
          },
          "по_виду": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "от",
                "к",
                "количество"
              ],
              "properties": {
                "от": {
                  "type": "string"
                },
                "к": {
                  "type": "string"
                },
                "количество": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "план_счетов": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "счетов",
          "ключевые_коды"
        ],
        "properties": {
          "счетов": {
            "type": "integer"
          },
          "ключевые_коды": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "организации": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "наименование",
            "ИНН"
          ],
          "properties": {
            "наименование": {
              "type": "string"
            },
            "ИНН": {
              "type": "string"
            }
          }
        }
      },
      "контрагенты": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "всего",
          "с_ИНН",
          "дублей_по_ИНН"
        ],
        "properties": {
          "всего": {
            "type": "integer"
          },
          "с_ИНН": {
            "type": "integer"
          },
          "дублей_по_ИНН": {
            "type": "integer"
          }
        }
      },
      "связность": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "цепочечных_документов",
          "с_основанием",
          "оценка",
          "комментарий"
        ],
        "properties": {
          "цепочечных_документов": {
            "type": "integer",
            "description": "СФ и платежи — те, у кого должно быть основание"
          },
          "с_основанием": {
            "type": "integer"
          },
          "оценка": {
            "type": "string",
            "enum": [
              "связный",
              "частичные_разрывы",
              "массовые_разрывы"
            ]
          },
          "комментарий": {
            "type": "string"
          }
        }
      },
      "аномалии_извлечения": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "пустые справочники, документы без организации/контрагента, подозрительно малое число записей"
      },
      "итог": {
        "type": "string"
      }
    }
  },
  "inputs": {
    "required": [
      {
        "from": "skill",
        "skill": "audit1c-extract",
        "path": "сущности",
        "fields": [
          "сущность",
          "записей"
        ]
      },
      {
        "from": "data",
        "entity": "doc1c",
        "fields": [
          "id",
          "Основание_uuid",
          "Проводки"
        ]
      }
    ],
    "optional": [
      {
        "from": "data",
        "entity": "ref1c",
        "note": "справочники: контрагенты, счета, договоры — рёбра графа ведут к ним"
      }
    ]
  },
  "produces": {
    "path": "документы_по_типам",
    "key": "тип",
    "join": "типдокумента"
  }
}
