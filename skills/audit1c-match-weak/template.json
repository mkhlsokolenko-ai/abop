{
  "name": "Аудит 1С · слабые сопоставления (match-weak)",
  "instruction": "Работай только с зоной без строгих ссылок: платежи без Основание_uuid, контрагенты без общего ИНН, документы с близкими суммами и датами. Для каждой гипотезы связи укажи, ЧТО именно совпало (сумма, дата, контрагент, договор, назначение), и уверенность. Ни одну гипотезу не выдавай за факт; «не удалось сопоставить» — валидный результат. Все id, суммы и даты — из данных.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "зона_неопределённости",
      "гипотезы",
      "не_сопоставлено",
      "итог"
    ],
    "properties": {
      "зона_неопределённости": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "платежей_без_основания",
          "кандидатов_в_дубли"
        ],
        "properties": {
          "платежей_без_основания": {
            "type": "integer"
          },
          "кандидатов_в_дубли": {
            "type": "integer"
          }
        }
      },
      "гипотезы": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "тип",
            "документ_а",
            "документ_б",
            "совпало",
            "уверенность",
            "разница_сумм",
            "нужно_подтверждение"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "устойчивый ключ гипотезы: тип + документ_а + документ_б, например «платёж→документ · СП-0007 · ПТ-0003»"
            },
            "тип": {
              "type": "string",
              "enum": [
                "платёж→документ",
                "дубль_контрагента",
                "дубль_номенклатуры",
                "иное"
              ]
            },
            "документ_а": {
              "type": "string",
              "description": "тип № от даты · сумма · контрагент (или карточка НСИ)"
            },
            "документ_б": {
              "type": "string"
            },
            "совпало": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "сумма",
                  "дата±окно",
                  "контрагент",
                  "договор",
                  "назначение",
                  "наименование",
                  "реквизиты"
                ]
              }
            },
            "уверенность": {
              "type": "string",
              "enum": [
                "высокая",
                "средняя",
                "низкая"
              ]
            },
            "разница_сумм": {
              "type": "string",
              "description": "в ₽, «0,00 ₽» если суммы равны"
            },
            "нужно_подтверждение": {
              "type": "boolean",
              "description": "всегда true для средней/низкой, для высокой — тоже, если сумма выше порога"
            }
          }
        }
      },
      "не_сопоставлено": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "документы, для которых кандидатов нет"
      },
      "итог": {
        "type": "string"
      }
    }
  },
  "max_tokens": 4000,
  "inputs": {
    "required": [
      {
        "from": "skill",
        "skill": "audit1c-graph-build",
        "path": "документы_по_типам",
        "fields": [
          "тип"
        ]
      },
      {
        "from": "data",
        "entity": "doc1c",
        "fields": [
          "id",
          "ДокументОснование"
        ]
      }
    ]
  },
  "produces": {
    "path": "гипотезы",
    "key": "id",
    "join": "гипотеза"
  }
}
