{
  "name": "Формулировка JTBD (jtbd-formulator)",
  "instruction": "По данным discovery (профиль ICP, боль, контекст, исходная «хотелка») сформулируй 1–3 Job To Be Done в структуре «Когда [ситуация/триггер], я хочу [мотивация], чтобы [результат]». Триггер — конкретная ситуация, не «вообще»; в формулировке нет названий продукта, технологий и «с помощью AI» — только работа и результат. Проверь каждый JTBD на функциональное, эмоциональное и социальное измерение; слишком широкие формулировки («хочу быть эффективнее») дожми до конкретной работы или отбрось с причиной. Имена, id, даты, суммы и цитаты — только из данных; ничего не выдумывай: если чего-то нет — пиши «не удалось определить» или оставляй список пустым. Допущения помечай явно. ПДн из вводных в формулировки не тиражируй.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "исходная_хотелка",
      "icp",
      "jtbd",
      "отброшенные_формулировки",
      "самопроверка",
      "следствия_для_ml_задачи",
      "открытые_вопросы",
      "допущения",
      "итог"
    ],
    "properties": {
      "исходная_хотелка": {
        "type": "string",
        "description": "как сформулировано в данных, дословно или близко"
      },
      "icp": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "кто",
          "контекст",
          "боль"
        ],
        "properties": {
          "кто": {
            "type": "string",
            "description": "роль/профиль из данных"
          },
          "контекст": {
            "type": "string",
            "description": "ситуация, в которой возникает работа"
          },
          "боль": {
            "type": "string",
            "description": "как описана в данных"
          }
        }
      },
      "jtbd": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "когда",
            "я_хочу",
            "чтобы",
            "формулировка",
            "функциональная_работа",
            "эмоциональное",
            "социальное",
            "основание",
            "уверенность"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "J-1, J-2, J-3"
            },
            "когда": {
              "type": "string",
              "description": "конкретный триггер: ситуация/момент"
            },
            "я_хочу": {
              "type": "string",
              "description": "мотивация/действие без упоминания средства"
            },
            "чтобы": {
              "type": "string",
              "description": "желаемый измеримый результат"
            },
            "формулировка": {
              "type": "string",
              "description": "полное предложение «Когда …, я хочу …, чтобы …»"
            },
            "эмоциональное": {
              "type": "string",
              "description": "что чувствует / чего избегает"
            },
            "социальное": {
              "type": "string",
              "description": "как выглядит в глазах других или «не выражено»"
            },
            "основание": {
              "type": "string",
              "description": "цитата/факт из данных discovery"
            },
            "уверенность": {
              "type": "string",
              "enum": [
                "высокая",
                "средняя",
                "низкая"
              ]
            },
            "функциональная_работа": {
              "type": "string",
              "description": "какую задачу решает"
            }
          }
        },
        "description": "1–3 главных JTBD"
      },
      "отброшенные_формулировки": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "формулировка",
            "почему",
            "во_что_дожато"
          ],
          "properties": {
            "формулировка": {
              "type": "string"
            },
            "почему": {
              "type": "string",
              "enum": [
                "слишком широко",
                "содержит решение или технологию",
                "триггер «вообще»",
                "дубликат",
                "не подтверждено данными"
              ]
            },
            "во_что_дожато": {
              "type": "string",
              "description": "id JTBD, в который переработано, или «отброшено»"
            }
          }
        }
      },
      "самопроверка": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "нет_названий_продукта_и_технологий",
          "триггеры_конкретны",
          "от_одного_до_трёх",
          "три_измерения_проверены",
          "комментарий"
        ],
        "properties": {
          "нет_названий_продукта_и_технологий": {
            "type": "boolean"
          },
          "триггеры_конкретны": {
            "type": "boolean"
          },
          "от_одного_до_трёх": {
            "type": "boolean"
          },
          "три_измерения_проверены": {
            "type": "boolean"
          },
          "комментарий": {
            "type": "string"
          }
        }
      },
      "следствия_для_ml_задачи": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jtbd_id",
            "кандидат_ml_задачи",
            "кандидат_метрики"
          ],
          "properties": {
            "jtbd_id": {
              "type": "string"
            },
            "кандидат_ml_задачи": {
              "type": "string",
              "description": "какая постановка вырастает из работы"
            },
            "кандидат_метрики": {
              "type": "string",
              "description": "как поймём, что работа выполнена"
            }
          }
        }
      },
      "открытые_вопросы": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "что уточнить у ICP/студента"
      },
      "допущения": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "итог": {
        "type": "string",
        "description": "1–2 предложения: сколько JTBD, главный, что дальше"
      }
    }
  },
  "max_tokens": 3200,
  "inputs": {
    "required": [
      {
        "from": "context",
        "note": "наблюдения о пользователе: интервью, обращения"
      }
    ],
    "optional": [
      {
        "from": "skill",
        "skill": "market-research",
        "path": "jtbd",
        "fields": [
          "функциональная_работа"
        ]
      },
      {
        "from": "skill",
        "skill": "icp-interviewer",
        "path": "проверочные_вопросы",
        "fields": [
          "вопрос",
          "ответ_icp"
        ],
        "note": "подсказка контракта называет интервью источником наблюдений"
      }
    ]
  },
  "produces": [
    {
      "path": "jtbd",
      "key": "функциональная_работа",
      "join": "работа"
    }
  ]
}
