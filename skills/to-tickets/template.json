              "иное"
            ]
          },
          "id": {
            "type": "string",
            "description": "id документа/задачи/письма из данных"
          },
          "автор": {
            "type": "string",
            "description": "из данных или «не удалось определить»"
          }
        }
      },
      "контекст_трекера": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "эпики",
          "компоненты",
          "спринт",
          "возможные_дубли"
        ],
        "properties": {
          "эпики": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "существующие эпики из данных, к которым ложатся тикеты"
          },
          "компоненты": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "компоненты/лейблы из трекера"
          },
          "спринт": {
            "type": "string",
            "description": "активный спринт из данных или «не удалось определить»"
          },
          "возможные_дубли": {
            "type": "array",
            "items": {
              "type": "string"
            },
