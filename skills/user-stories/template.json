{
  "name": "Пользовательские истории и сценарии (user-stories)",
  "instruction": "Собери из материалов роли, боли, пользовательские истории и сценарии использования. Каждая боль — со ссылкой на источник (цитата интервью, тема обращения с долей, разрыв процесса). История — «Как <роль>, я хочу <действие>, чтобы <ценность>», одна история = один результат для пользователя. Критерии приёмки — «дано/когда/тогда», проверяемые. Числа и цитаты бери только из материалов, не выдумывай; чего нет — в пробелы. ПРИОРИТЕТ ИСТОЧНИКА: если в блоке ЗАДАЧА ПОЛЬЗОВАТЕЛЯ есть документ или материалы — работай по ним, данные систем используй как справку.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "роли",
      "боли",
      "истории",
      "сценарии",
      "пробелы",
      "итог"
    ],
    "properties": {
      "роли": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "роль",
            "что_делает",
            "основание"
          ],
          "properties": {
            "роль": {
              "type": "string"
            },
            "что_делает": {
              "type": "string"
            },
            "основание": {
              "type": "string",
              "description": "откуда роль: интервью, обращение, процесс; «предположение», если прямого подтверждения нет"
            }
          }
        }
      },
      "боли": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "роль",
            "боль",
            "источник",
            "частота"
          ],
          "properties": {
            "роль": {
              "type": "string"
            },
            "боль": {
              "type": "string"
            },
            "источник": {
              "type": "string",
              "description": "цитата или тема обращения / шаг процесса"
            },
            "частота": {
              "type": "string",
              "description": "число из материалов: доля обращений, время, объём; «—» если нет"
            }
          }
        }
      },
      "истории": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "роль",
            "хочу",
            "чтобы",
            "критерии_приёмки",
            "ценность",
            "частота",
            "обоснование"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "US-1, US-2…"
            },
            "роль": {
              "type": "string"
            },
            "хочу": {
              "type": "string"
            },
            "чтобы": {
              "type": "string"
            },
            "критерии_приёмки": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "дано",
                  "когда",
                  "тогда"
                ],
                "properties": {
                  "дано": {
                    "type": "string"
                  },
                  "когда": {
                    "type": "string"
                  },
                  "тогда": {
                    "type": "string"
                  }
                }
              }
            },
            "ценность": {
              "type": "string",
              "enum": [
                "высокая",
                "средняя",
                "низкая"
              ]
            },
            "частота": {
              "type": "string"
            },
            "обоснование": {
              "type": "string",
              "description": "почему такой приоритет: число из материалов"
            }
          }
        }
      },
      "сценарии": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "название",
            "история",
            "действующее_лицо",
            "предусловие",
            "основной_поток",
            "альтернативные_потоки",
            "исключения",
            "результат"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "UC-1…"
            },
            "название": {
              "type": "string"
            },
            "история": {
              "type": "string",
              "description": "id истории, которую раскрывает сценарий"
            },
            "действующее_лицо": {
              "type": "string"
            },
            "предусловие": {
              "type": "string"
            },
            "основной_поток": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "шаги по порядку"
            },
            "альтернативные_потоки": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "исключения": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "что если сбой, нет прав, нет данных"
            },
            "результат": {
              "type": "string"
            }
          }
        }
      },
      "пробелы": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "чего_не_хватает",
            "кому_задать"
          ],
          "properties": {
            "чего_не_хватает": {
              "type": "string"
            },
            "кому_задать": {
              "type": "string"
            }
          }
        }
      },
      "итог": {
        "type": "string",
        "description": "что брать в работу первым и почему"
      }
    }
  },
  "max_tokens": 5000,
  "delivery": {
    "system": "bookstack",
    "type": "page.publish",
    "limit": 1,
    "title": "Истории и сценарии → вики",
    "payload": {
      "book_id": 1,
      "title": "Пользовательские истории и сценарии: {{итог}}",
      "markdown": "# Пользовательские истории и сценарии\n\n{{итог}}\n\n## Роли\n\n{{#роли}}\n\n## Боли и их источники\n\n{{#боли}}\n\n## Истории\n\n{{#истории}}\n\n## Сценарии использования\n\n{{#сценарии}}\n\n## Пробелы\n\n{{#пробелы}}\n\n---\nСформировано ABOP (навык user-stories) из материалов исследования."
    }
  },
  "inputs": {
    "required": [
      {
        "from": "context",
        "note": "материалы исследования: интервью, обращения поддержки, описание процесса, черновик требований"
      }
    ]
  },
  "produces": [
    {
      "path": "истории",
      "key": "id",
      "join": "история"
    },
    {
      "path": "сценарии",
      "key": "id",
      "join": "сценарий"
    }
  ]
}
