{
  "name": "Витрина · нарушения требований по карточкам (feed-checks)",
  "instruction": "Ты раскладываешь ПЕРЕЧЕНЬ НАРУШЕНИЙ, который уже посчитал детерминированный движок (блок с результатом feed_checks). Не ищи новых и не убирай существующие. Заполни схему: сводка по кодам, перечень нарушений 1:1 с движком (карточка, код, поле, доказательство, чинится), две очереди работы — «из данных» и «человеком», и строка про то, что опубликованные требования витрины не равны всему её чек-листу. Числа бери строго из результата движка.",
  "max_tokens": 2600,
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "сводка",
      "нарушения",
      "очереди",
      "оговорка"
    ],
    "properties": {
      "сводка": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "карточек_проверено",
          "карточек_с_нарушениями",
          "нарушений_всего",
          "по_кодам"
        ],
        "properties": {
          "карточек_проверено": {
            "type": "integer"
          },
          "карточек_с_нарушениями": {
            "type": "integer"
          },
          "нарушений_всего": {
            "type": "integer"
          },
          "по_кодам": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "код",
                "сколько",
                "что_значит"
              ],
              "properties": {
                "код": {
                  "type": "string"
                },
                "сколько": {
                  "type": "integer"
                },
                "что_значит": {
                  "type": "string",
                  "description": "причина словами, без кода"
                }
              }
            }
          }
        }
      },
      "нарушения": {
        "type": "array",
        "description": "строки 1:1 с движком, без добавлений",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "карточка",
            "название",
            "код",
            "поле",
            "доказательство",
            "чинится"
          ],
          "properties": {
            "карточка": {
              "type": "string"
            },
            "название": {
              "type": "string"
            },
            "код": {
              "type": "string"
            },
            "поле": {
              "type": "string"
            },
            "доказательство": {
              "type": "string",
              "description": "конкретика из данных: чего нет, какая единица пришла, сколько изображений"
            },
            "чинится": {
              "type": "string",
              "enum": [
                "из данных",
                "человеком"
              ]
            }
          }
        }
      },
      "очереди": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "из_данных_карточек",
          "человеком_карточек",
          "что_просить_у_человека"
        ],
        "properties": {
          "из_данных_карточек": {
            "type": "integer"
          },
          "человеком_карточек": {
            "type": "integer"
          },
          "что_просить_у_человека": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "конкретный запрос: снимки, маркировка, решение по категории"
            }
          }
        }
      },
      "оговорка": {
        "type": "string",
        "description": "проверено по опубликованным требованиям витрины; её внутренний чек-лист шире, и часть отказов этими проверками не ловится"
      }
    }
  },
  "produces": [
    {
      "path": "нарушения",
      "key": "карточка",
      "join": "карточка"
    }
  ],
  "inputs": {
    "required": [
      {
        "from": "data",
        "entity": "feed_card",
        "fields": [
          "id",
          "название",
          "категория_поставщика",
          "атрибуты",
          "маркировка",
          "изображений"
        ]
      },
      {
        "from": "data",
        "entity": "showcase_rule",
        "fields": [
          "категория",
          "обязательные_атрибуты",
          "единицы",
          "маркировка",
          "минимум_изображений",
          "лимит_названия",
          "запреты_в_названии"
        ]
      }
    ],
    "optional": [
      {
        "from": "data",
        "entity": "category_map",
        "fields": [
          "категория_поставщика",
          "категория_витрины"
        ]
      }
    ]
  }
}
