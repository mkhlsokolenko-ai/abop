{
  "name": "Недельная сводка (weekly-update)",
  "instruction": "По метрикам и событиям недели из Data Plane (трекер, аналитика, дашборды) собери плотную сводку на минуту чтения: 3–5 ключевых метрик с числом и сравнением с прошлой неделей/планом, аномалии и отклонения без сглаживания (что и гипотеза почему), принятые решения (что/кто/эффект), конкретный план на следующую неделю (что/кто). Каждая цифра — со ссылкой на источник; числа и даты — только из данных, нет данных за неделю — пиши «нет данных», не оценивай на глаз. ПДн и чувствительные данные не раскрывай; допущения помечай явно.",
  "json_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "период",
      "метрики",
      "аномалии",
      "решения",
      "план_на_неделю",
      "нет_данных",
      "итог"
    ],
    "properties": {
      "период": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "неделя",
          "дата_от",
          "дата_до",
          "источники"
        ],
        "properties": {
          "неделя": {
            "type": "string",
            "description": "напр. «неделя 39, 2026-09-21…2026-09-27»"
          },
          "дата_от": {
            "type": "string",
            "description": "ГГГГ-ММ-ДД"
          },
          "дата_до": {
            "type": "string"
          },
          "источники": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "метрики": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "метрика",
            "значение",
            "прошлая_неделя",
            "план",
            "изменение",
            "оценка",
            "источник"
          ],
          "properties": {
            "метрика": {
              "type": "string"
            },
            "значение": {
              "type": "string",
              "description": "с единицей"
            },
            "прошлая_неделя": {
              "type": "string",
              "description": "или «нет данных»"
            },
            "план": {
              "type": "string",
              "description": "или «—»"
            },
            "изменение": {
              "type": "string",
              "description": "абс. и %"
            },
            "оценка": {
              "type": "string",
              "enum": [
                "в_норме",
                "лучше",
                "хуже",
                "нет_данных"
              ]
            },
            "источник": {
              "type": "string"
            }
          }
        },
        "description": "3–5 главных метрик недели"
      },
      "аномалии": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "что",
            "метрика_или_событие",
            "гипотеза_почему",
            "критичность",
            "кому_передать"
          ],
          "properties": {
            "что": {
              "type": "string",
              "description": "провал/всплеск/сорванный срок — с числом"
            },
            "метрика_или_событие": {
              "type": "string"
            },
            "гипотеза_почему": {
              "type": "string"
            },
