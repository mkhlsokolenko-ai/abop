    ],
    "optional": [
      {
        "from": "skill",
        "skill": "dashboard-builder",
        "path": "дерево_метрик",
        "fields": [
          "метрика",
          "источник_система"
        ]
      }
    ]
  },
  "produces": [
    {
      "path": "метрики",
