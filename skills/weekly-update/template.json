              "type": "string"
            },
            "эффект": {
              "type": "string",
              "description": "на что влияет"
            },
            "дата": {
              "type": "string",
              "description": "ГГГГ-ММ-ДД"
            },
            "источник": {
              "type": "string"
            }
          }
        },
        "description": "память команды за неделю"
