{
  "name": "abop-desktop",
  "version": "1.0.6",
  "description": "ABOP Desktop — тонкий клиент-рантайм ABOP (Electron + Python sidecar)",
  "author": { "name": "ABOP", "email": "mkhlsokolenko@gmail.com" },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "pro.abop.desktop",
    "productName": "ABOP Desktop",
    "files": ["electron/**", "ui/**", "build/icon.ico", "build/icon.png"],
    "extraResources": [
      { "from": "dist/ape-sidecar", "to": "ape-sidecar" }
    ],
    "publish": [
      { "provider": "github", "owner": "mkhlsokolenko-ai", "repo": "abop", "releaseType": "release" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "ABOP Desktop"
    }
  }
}
