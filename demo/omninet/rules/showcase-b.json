{
  "id": "showcase-b",
  "название": "Требования витрины B к карточке товара",
  "предмет": "feed_card",
  "область": "management",
  "версия": 1,
  "источник": "опубликованные требования витрины",
  "контекст": [
    {
      "имя": "категория",
      "из": "category_map",
      "по": {
        "категория_поставщика": "$запись.категория_поставщика"
      },
      "взять": "категория_витрины",
      "если_нет": {
        "код": "CATEGORY_UNMAPPED",
        "причина": "категория поставщика не сопоставлена категории витрины",
        "поле": "категория",
        "чинится": "человеком",
        "подсказка": "внести соответствие в справочник категорий"
      }
    },
    {
      "имя": "правила",
      "из": "showcase_rule",
      "по": {
        "категория": "@категория"
      }
    }
  ],
  "правила": [
    {
      "код": "ATTR_MISSING",
      "предикат": "поле_обязательно",
      "параметры": {
        "поля": "@правила.обязательные_атрибуты",
        "в": "атрибуты"
      },
      "причина": "не заполнен обязательный атрибут категории",
      "серьёзность": "высокая",
      "чинится": "из данных",
      "подсказка": "запросить значения у поставщика"
    },
    {
      "код": "UNIT_MISMATCH",
      "предикат": "единицы_измерения",
      "параметры": {
        "единицы": "@правила.единицы",
        "в": "атрибуты"
      },
      "причина": "единица измерения не из допустимых для атрибута",
      "серьёзность": "средняя",
      "чинится": "из данных",
      "подсказка": "пересчёт однозначен — привести к единице витрины"
    },
    {
      "код": "MARKING_REQUIRED",
      "предикат": "поле_обязательно",
      "параметры": {
        "поля": [
          "маркировка"
        ],
        "при": "@правила.маркировка"
      },
      "причина": "категория требует маркировку, в карточке её нет",
      "серьёзность": "высокая",
      "чинится": "человеком",
      "подсказка": "получить маркировку у поставщика"
    },
    {
      "код": "IMAGES_FEW",
      "предикат": "не_меньше",
      "параметры": {
        "поле": "изображений",
        "минимум": "@правила.минимум_изображений"
      },
      "причина": "изображений меньше минимума категории",
      "серьёзность": "средняя",
      "чинится": "человеком",
      "подсказка": "снять недостающие изображения"
    },
    {
      "код": "TITLE_TOO_LONG",
      "предикат": "не_длиннее",
      "параметры": {
        "поле": "название",
        "предел": "@правила.лимит_названия"
      },
      "причина": "название длиннее лимита категории",
      "серьёзность": "низкая",
      "чинится": "из данных",
      "подсказка": "сократить, сохранив бренд, тип и модель"
    },
    {
      "код": "TITLE_FORBIDDEN",
      "предикат": "не_содержит",
      "параметры": {
        "поле": "название",
        "запреты": "@правила.запреты_в_названии"
      },
      "причина": "в названии рекламная формулировка",
      "серьёзность": "средняя",
      "чинится": "из данных",
      "подсказка": "убрать рекламную формулировку"
    }
  ]
}
