    "field": "репозиторий",
    "spec": "const:abop/flow-demo"
   }
  ],
  "map": {
   "id": {
    "col": "sha"
   },
   "дата": {
    "col": "commit.author.date"
   },
   "автор": {
    "col": "commit.author.name"
   },
   "сообщение": {
    "col": "commit.message"
   },
   "задача": {
    "col": "commit.message",
    "regex": "#(\\d+)",
    "иначе": ""
   },
   "ветка": {
    "const": "main"
   },
   "репозиторий": {
    "const": "abop/flow-demo"
   }
  },
  "rules": [],
  "emit": {
   "schema": "commit",
   "ttl_sec": 0,
   "schema_version": "1.0"
  },
  "заметка": "Коммиты главной ветки. Номер задачи вынимается из сообщения коммита шаблоном рецепта: у заказчика это «#123», «PRJ-123» или «task/123» — шаблону не место в коде. Токен лежит файлом, поэтому его нет ни в определении рецепта, ни в выгрузке."
 },
