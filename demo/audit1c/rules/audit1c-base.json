{
  "id": "audit1c-base",
  "название": "Аудит данных 1С: инварианты, цепочки, НСИ, нормы",
  "предмет": "doc1c",
  "область": "finance",
  "версия": 1,
  "источник": "методика аудита учётных данных (классы A/B/C/D)",
  "контекст": [
    {
      "имя": "оплата_покупателя",
      "из": "doc1c",
      "по": {
        "Основание_uuid": "$запись.id",
        "тип": "ПоступлениеНаРасчётныйСчёт"
      },
      "необязательно": true
    },
    {
      "имя": "оплата_поставщику",
      "из": "doc1c",
      "по": {
        "Основание_uuid": "$запись.id",
        "тип": "СписаниеСРасчётногоСчёта"
      },
      "необязательно": true
    },
    {
      "имя": "сф_выданный",
      "из": "doc1c",
      "по": {
        "Основание_uuid": "$запись.id",
        "тип": "СчётФактураВыданный"
      },
      "необязательно": true
    },
    {
      "имя": "сф_полученный",
      "из": "doc1c",
      "по": {
        "Основание_uuid": "$запись.id",
        "тип": "СчётФактураПолученный"
      },
      "необязательно": true
    },
    {
      "имя": "основание",
      "из": "doc1c",
      "по": {
        "id": "$запись.Основание_uuid"
      },
      "необязательно": true
    },
    {
      "имя": "контрагент_инн",
      "из": "ref1c",
      "по": {
        "id": "$запись.Контрагент_uuid"
      },
      "взять": "ИНН",
      "необязательно": true
    },
    {
      "имя": "инн_группы",
      "из": "ref1c",
      "по": {
        "тип": "Организации"
      },
      "взять": "ИНН",
      "все": true,
      "необязательно": true
    },
    {
      "имя": "организация_группы",
      "из": "ref1c",
      "по": {
        "тип": "Организации",
        "ИНН": "@контрагент_инн"
      },
      "взять": "Наименование",
      "необязательно": true
    }
  ],
  "правила": [
    {
      "код": "B1",
      "предикат": "связанный_документ_есть",
      "применять_если": {
        "тип": "РеализацияТоваровУслуг"
      },
      "параметры": {
        "из": "doc1c",
        "по": {
          "Основание_uuid": "$запись.id",
          "тип": "СчётФактураВыданный"
        }
      },
      "серьёзность": "высокая",
      "доказательство": "нет документа СчётФактураВыданный с ДокументОснование = $запись.id",
      "вывод": {
        "класс": "B",
        "проверка": "Реализация без счёта-фактуры выданного",
        "описание": "НДС по реализации не предъявлен покупателю (нет СчётФактураВыданный на основании этой реализации)."
      },
      "цепочка": [
        {
          "звено": "Реализация",
          "документ": "$запись",
          "примечание": "СуммаДокумента $запись.СуммаДокумента"
        },
        {
          "звено": "Счёт-фактура выданный (НДС)",
          "есть": false,
          "примечание": "счёта-фактуры нет"
        },
        {
          "звено": "Оплата · взаиморасчёты",
          "документ": "@оплата_покупателя",
          "примечание_если_нет": "поступления на р/с нет"
        }
      ]
    },
    {
      "код": "B2",
      "предикат": "связанный_документ_есть",
      "применять_если": {
        "тип": "ПоступлениеТоваровУслуг"
      },
      "параметры": {
        "из": "doc1c",
        "по": {
          "Основание_uuid": "$запись.id",
          "тип": "СчётФактураПолученный"
        }
      },
      "серьёзность": "высокая",
      "доказательство": "нет документа СчётФактураПолученный с ДокументОснование = $запись.id",
      "вывод": {
        "класс": "B",
        "проверка": "Поступление без счёта-фактуры полученного",
        "описание": "НДС к вычету не подтверждён (нет входящего счёта-фактуры на основании этого поступления)."
      },
      "цепочка": [
        {
          "звено": "Поступление",
          "документ": "$запись"
        },
        {
          "звено": "Счёт-фактура полученный (вычет НДС)",
          "есть": false,
          "примечание": "счёта-фактуры нет"
        },
        {
          "звено": "Оплата поставщику",
          "документ": "@оплата_поставщику",
          "примечание_если_нет": "списания с р/с нет"
        }
      ]
    },
    {
      "код": "B3",
      "предикат": "поле_обязательно",
      "применять_если": {
        "тип": [
          "СписаниеСРасчётногоСчёта",
          "ПоступлениеНаРасчётныйСчёт"
        ]
      },
      "параметры": {
        "поля": [
          "Основание_uuid"
        ]
      },
      "серьёзность": "средняя",
      "доказательство": "поле ДокументОснование пустое",
      "вывод": {
        "класс": "B",
        "проверка": "Оплата без документа-основания",
        "описание": "Платёж не привязан к документу поставки/реализации — разрыв цепочки, риск нераспознанной оплаты."
      },
      "цепочка": [
        {
          "звено": "Документ-основание (поставка/реализация)",
          "есть": false,
          "примечание": "ДокументОснование пустое"
        },
        {
          "звено": "Платёж",
          "документ": "$запись"
        }
      ]
    },
    {
      "код": "B4",
      "предикат": "связанный_документ_есть",
      "применять_если": {
        "тип": "ПоступлениеТоваровУслуг"
      },
      "параметры": {
        "из": "doc1c",
        "по": {
          "Основание_uuid": "$запись.id",
          "тип": "СписаниеСРасчётногоСчёта"
        }
      },
      "серьёзность": "средняя",
      "доказательство": "нет СписаниеСРасчётногоСчёта с ДокументОснование = $запись.id",
      "вывод": {
        "класс": "B",
        "проверка": "Поступление не оплачено (кредиторка)",
        "описание": "По поступлению нет списания с р/с — открытая кредиторская задолженность перед поставщиком."
      },
      "цепочка": [
        {
          "звено": "Поступление",
          "документ": "$запись"
        },
        {
          "звено": "Счёт-фактура полученный",
          "документ": "@сф_полученный"
        },
        {
          "звено": "Оплата поставщику",
          "есть": false,
          "примечание": "списания с р/с нет"
        }
      ]
    },
    {
      "код": "B5",
      "предикат": "связанный_документ_есть",
      "применять_если": {
        "тип": "РеализацияТоваровУслуг"
      },
      "параметры": {
        "из": "doc1c",
        "по": {
          "Основание_uuid": "$запись.id",
          "тип": "ПоступлениеНаРасчётныйСчёт"
        }
      },
      "серьёзность": "средняя",
      "доказательство": "нет ПоступлениеНаРасчётныйСчёт с ДокументОснование = $запись.id",
      "вывод": {
        "класс": "B",
        "проверка": "Реализация не оплачена (дебиторка)",
        "описание": "По реализации нет поступления на р/с — открытая дебиторская задолженность покупателя."
      },
      "цепочка": [
        {
          "звено": "Реализация",
          "документ": "$запись"
        },
        {
          "звено": "Счёт-фактура выданный",
          "документ": "@сф_выданный"
        },
        {
          "звено": "Оплата покупателя",
          "есть": false,
          "примечание": "поступления на р/с нет"
        }
      ]
    },
    {
      "код": "A1",
      "предикат": "есть_строка_со_значением",
      "применять_если": {
        "тип": "РеализацияТоваровУслуг"
      },
      "параметры": {
        "в": "Проводки",
        "поле": "СчётДт",
        "равно": "90.02",
        "через_справочник": {
          "из": "ref1c",
          "где": {
            "тип": "Счета"
          },
          "ключ": "id",
          "взять": "Код",
          "поле_ссылки": "uuid"
        }
      },
      "серьёзность": "высокая",
      "доказательство": "среди проводок нет дебета счёта 90.02; коды Дт: $факт.найдено",
      "вывод": {
        "класс": "A",
        "проверка": "Реализация без списания себестоимости",
        "описание": "Признана выручка (90.01), но нет проводки Дт 90.02 Кт 41 — себестоимость продаж не списана, прибыль завышена."
      },
      "цепочка": [
        {
          "звено": "Выручка Дт 62 Кт 90.01",
          "документ": "$запись",
          "примечание": "коды Дт: $факт.найдено"
        },
        {
          "звено": "Себестоимость Дт 90.02 Кт 41",
          "есть": false,
          "примечание": "проводки нет"
        }
      ]
    },
    {
      "код": "D1",
      "предикат": "значение_из_словаря",
      "применять_если": {
        "тип": [
          "РеализацияТоваровУслуг",
          "ПоступлениеТоваровУслуг"
        ]
      },
      "параметры": {
        "поле": "Контрагент_uuid",
        "допустимые": "@инн_группы",
        "нарушение_если": "входит",
        "значение": "@контрагент_инн"
      },
      "серьёзность": "высокая",
      "доказательство": "ИНН контрагента @контрагент_инн = организация «@организация_группы»",
      "вывод": {
        "класс": "D",
        "проверка": "Внутригрупповой оборот (ВГО)",
        "описание": "Контрагент по ИНН совпадает с организацией холдинга — оборот внутригрупповой, подлежит элиминации при консолидации."
      },
      "цепочка": [
        {
          "звено": "$запись.тип ($запись.Организация)",
          "документ": "$запись"
        },
        {
          "звено": "Зеркальный документ у «@организация_группы»",
          "есть": true,
          "статус": "н/д",
          "примечание": "проверить у второй организации группы"
        },
        {
          "звено": "Элиминация при консолидации",
          "есть": false,
          "примечание": "оборот не помечен как ВГО"
        }
      ]
    },
    {
      "код": "D2",
      "предикат": "период_совпадает",
      "применять_если": {
        "тип": [
          "СписаниеСРасчётногоСчёта",
          "ПоступлениеНаРасчётныйСчёт"
        ]
      },
      "параметры": {
        "поле": "Дата",
        "с": "@основание.Дата",
        "точность": "год"
      },
      "серьёзность": "средняя",
      "доказательство": "оплата $запись.Дата ↔ основание @основание.Номер от @основание.Дата",
      "вывод": {
        "класс": "D",
        "проверка": "Переходящая операция (разные периоды)",
        "описание": "Оплата и документ-основание в разных отчётных годах — контроль отражения на границе периода."
      },
      "цепочка": [
        {
          "звено": "Основание ($факт.чужой_период)",
          "документ": "@основание"
        },
        {
          "звено": "Оплата ($факт.свой_период)",
          "документ": "$запись"
        },
        {
          "звено": "Отражение на границе периода",
          "есть": true,
          "статус": "ПРОВЕРИТЬ",
          "примечание": "cut-off 31.12"
        }
      ]
    }
  ]
}
